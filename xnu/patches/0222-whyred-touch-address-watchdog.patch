+static void
+whyred_disarm_reboot_watchdog(void)
+{
+	if (!whyred_reboot_watchdog_armed) {
+		return;
+	}
+	whyred_reboot_watchdog_cancel = 1;
+	wakeup(&whyred_reboot_watchdog);
+	printf("WHYRED TOUCH: reboot watchdog disarmed, probe finished\n");
