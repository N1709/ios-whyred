diff --git a/pexpert/pexpert/arm64/board_config.h b/pexpert/pexpert/arm64/board_config.h
+++ b/pexpert/pexpert/arm64/board_config.h
@@ -108,6 +108,20 @@
 
 #endif  /* ARM64_BOARD_CONFIG_SWEET */
 
+#ifdef ARM64_BOARD_CONFIG_A05S
+#include <pexpert/arm64/A05S.h>
+
+#define MAX_L2_CLINE                   6
+/* Bring-up starts a single cluster, mirroring sweet's cpus=6 path: a05s
+ * cores 0-3 are the Cortex-A53 cluster. Adding the four Cortex-A73s is a
+ * separate step (cluster discovery + MPIDR affinity), not a define. */
+#define MAX_CPUS                       8
+#define MAX_CPU_CLUSTERS               1
+
+#define CORE_NCTRS                     8 /* Placeholder; KPC is not enabled for this target */
+
+#endif  /* ARM64_BOARD_CONFIG_A05S */
+
 #ifdef ARM64_BOARD_CONFIG_VMAPPLE
 #include <pexpert/arm64/VMAPPLE.h>
 
