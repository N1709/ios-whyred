diff -urN PRE/pexpert/pexpert/arm64/A05S.h POST/pexpert/pexpert/arm64/A05S.h
diff --git a/pexpert/pexpert/arm64/A05S.h b/pexpert/pexpert/arm64/A05S.h
+++ b/pexpert/pexpert/arm64/A05S.h
@@ -0,0 +1,56 @@
+/*
+ * Board config for the Samsung Galaxy A05s ("a05s", Qualcomm SM6225 /
+ * Snapdragon 680): Kryo 265 = 4x Cortex-A73 + 4x Cortex-A53, ARMv8.0, no PAC.
+ *
+ * DELIBERATELY NOT A COPY OF SWEET.h. sweet is Kryo 470 (Cortex-A76 + A55,
+ * ARMv8.2). Two of sweet's choices are undefined instructions on ARMv8.0
+ * silicon: __ARM_PAN_AVAILABLE__ (PAN is v8.1, so MSR PAN traps) and the
+ * -march=armv8.2-a in makedefs/MakeInc.def (it lets the compiler choose LSE
+ * atomics, also v8.1). The ARMv8.0-safe precedent is Apple's own BCM2837
+ * config (Raspberry Pi 3, Cortex-A53), which omits __ARM_PAN_AVAILABLE__;
+ * without a v8.2 march __ARM_ARCH_8_2__ stays undefined and
+ * osfmk/arm64/machine_routines_asm.s selects its ll/sc path (ldaxr/stxr).
+ *
+ * Board MMIO bases (GICD/GICR, UFS host, framebuffer) are NOT in this header:
+ * they reach the kernel at runtime through the Apple Device Tree built by
+ * tools/mkadt.py. Only feature presence and cache geometry are compiled in.
+ *
+ * BRING-UP STATE: sweet's driver patches gate their code on #if defined(SWEET).
+ * A05S does not define SWEET, so a MACHINE_CONFIG=A05S kernel builds this
+ * config surface with no UFS, GIC platform-expert, HID or framebuffer driver.
+ * That is the point of this step -- prove the ARMv8.0 ISA surface compiles and
+ * links. The GIC register offsets and the Qualcomm timer PPI numbering arrive
+ * with the shared-umbrella pass that replaces those SWEET tests.
+ */
+
+#ifndef _PEXPERT_ARM64_A05S_H
+#define _PEXPERT_ARM64_A05S_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define A05S                      1
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+
+/* __ARM_PAN_AVAILABLE__ intentionally absent: PAN is ARMv8.1, and PSR64_PAN in
+ * osfmk/arm64/proc_reg.h is its only consumer, already guarded by #if. */
+
+#define __ARM_16K_PG__            1   /* 16K granule is mandatory in ARMv8.0 and
+                                       * the iOS userland requires 16K pages --
+                                       * unlike BCM2837, which is configured 4K */
+
+#define HAS_GIC_V3                1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+#endif /* ! _PEXPERT_ARM64_A05S_H */
