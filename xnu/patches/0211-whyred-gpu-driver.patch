diff --git a/bsd/dev/whyred_gpu.c b/bsd/dev/whyred_gpu.c
new file mode 100644
index 0000000..f88769e
--- /dev/null
+++ b/bsd/dev/whyred_gpu.c
@@ -0,0 +1,2669 @@
+/*
+ * whyred: Adreno 512 bring-up ladder (M1). Boot-arg gated, off by default.
+ *
+ *   whyredgpu=N        run the ladder up to step N (0 or absent: nothing happens)
+ *   whyredgpudelay=S   seconds to wait after boot before step 1 (default 25), so
+ *                   the log flusher and the USB live log are up
+ *
+ * Steps, each one announced BEFORE the access, with a 2 s pause so the log
+ * reaches the eMMC ring / USB (a wrong access on this SoC usually resets it
+ * without a word):
+ *   1  reads only: GCC branch state, and (if the GPU config AHB clock is on)
+ *      the GPUCC block: PLLs, GDSCs, branches
+ *   2  vote gcc_gpu_bimc_gfx_clk and gcc_bimc_gfx_clk, check the halt bits
+ *   3  switch the CX GDSC on if it is off
+ *   4  switch the GX GDSC on, release the GMEM clamp, enable the GFX3D core
+ *      and RBBM timer branches (RCG left as the bootloader set it), then READ
+ *      the RBBM / CP registers at 0x05000000
+ * Nothing in this file writes a register inside the GPU block (0x05000000);
+ * steps 2-4 write only GCC branch votes, GDSC controls and gpucc branches. No rail (CPR/RPM) vote is made:
+ * step 4 is exactly the question "is the bootloader's rail state enough?".
+ *
+ * Offsets: Linux gcc-sdm660.c / gpucc-sdm660.c and Mesa a5xx.xml, read as
+ * behaviour reference (values only, no code copied).
+ */
+#if defined(ARM64_BOARD_CONFIG_WHYRED)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <sys/vnode.h>
+#include <sys/fcntl.h>
+#include <sys/uio.h>
+#include <sys/kauth.h>
+#include <arm/caches_internal.h>
+#include <vm/memory_types.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <libkern/libkern.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define GCC_PA          0x00100000u
+#define GCC_SIZE        0x80000u
+#define GPUCC_PA        0x05065000u
+#define GPUCC_SIZE      0x10000u
+#define GPU_PA          0x05000000u
+#define GPU_SIZE        0x40000u
+
+/* GCC (byte offsets from GCC_PA) */
+#define GCC_GPU_CFG_AHB         0x71004u
+#define GCC_GPU_BIMC_GFX        0x71010u
+#define GCC_BIMC_GFX            0x7106cu
+#define GCC_GPLL0_VOTE          0x5200cu        /* bit 4 = gcc_gpu_gpll0_clk */
+
+/* GPUCC (byte offsets from GPUCC_PA) */
+#define CC_GPU_PLL0_MODE        0x0000u
+#define CC_GPU_PLL1_MODE        0x0040u
+#define CC_CX_GDSCR             0x1004u
+#define CC_CX_GDS_HW_CTRL       0x1008u
+#define CC_GX_GDSCR             0x1094u
+#define CC_GX_CLAMP_IO          0x0130u
+#define CC_GX_BCR               0x1090u
+#define GX_GMEM_RESET           (1u << 4)
+#define CC_GFX3D_CLK            0x1098u
+#define CC_GFX3D_RCG_CMD        0x1070u
+#define CC_GFX3D_RCG_CFG        0x1074u
+#define CC_RBBMTIMER_CLK        0x10d0u
+#define CC_RBBMTIMER_RCG_CMD    0x10b0u
+#define CC_RBCPR_CLK            0x1054u
+#define CC_RBCPR_RCG_CMD        0x1030u
+#define CC_CX_GFX3D_CLK         0x1020u
+
+/* GPU block (byte offsets; A5xx dword offsets from a5xx.xml times 4) */
+#define A5_CP_RB_BASE           (0x0800u * 4)
+#define A5_CP_RB_CNTL           (0x0802u * 4)
+#define A5_RBBM_SW_RESET_CMD    (0x0043u * 4)
+#define A5_RBBM_CLOCK_CNTL      (0x0067u * 4)
+#define A5_RBBM_INT_0_STATUS    (0x04e1u * 4)
+#define A5_RBBM_AHB_ERR_STATUS  (0x04f4u * 4)
+#define A5_RBBM_STATUS          (0x04f5u * 4)
+#define A5_RBBM_STATUS3         (0x0530u * 4)
+#define A5_RBBM_SECVID_TRUST    (0xf400u * 4)
+
+#define RCG_ROOT_EN     (1u << 1)
+#define RCG_ROOT_OFF    (1u << 31)
+/* msm_gfx_ldo block, inside the GPUCC window (0x0506e000 - 0x05065000) */
+#define CC_LDO                  0x9000u
+#define CC_LDO_PWRSWITCH_CTRL   (CC_LDO + 0x1cu)
+#define CC_LDO_STATUS1          (CC_LDO + 0x24u)
+#define CC_LDO_PWRSWITCH_STATUS (CC_LDO + 0x28u)
+#define LDO_BHS_UNDER_SW        (1u << 0)
+#define LDO_BHS_EN_FEW          (1u << 1)
+#define LDO_BHS_EN_REST         (1u << 2)
+#define LDO_UNDER_SW_CTRL       (1u << 4)
+#define LDO_PWR_SRC_SEL         (1u << 9)
+#define LDO_CPR_BYPASS          (1u << 30)
+
+#define CBCR_OFF        (1u << 31)
+#define CBCR_EN         (1u << 0)
+#define GDSC_PWR_ON     (1u << 31)
+#define GDSC_COLLAPSE   (1u << 0)
+
+static vm_offset_t gcc, gpucc, gpu;
+static int gx_on;
+static int whyred_chan;
+
+static inline uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dsb ld" ::: "memory");
+	return v;
+}
+
+static inline void
+wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+whyred_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&whyred_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* Announce, then give the log 2 s to leave the machine. */
+static void
+whyred_announce(const char *what)
+{
+	printf("WHYRED GPU: about to %s\n", what);
+	whyred_wait(2000);
+}
+
+/* Poll a bit until it equals want; returns the last value. */
+static uint32_t
+whyred_poll_n(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, int n)
+{
+	uint32_t v = 0;
+	for (int i = 0; i < n; i++) {
+		v = rd(base, off);
+		if ((v & mask) == want) {
+			break;
+		}
+		whyred_wait(10);
+	}
+	return v;
+}
+
+static uint32_t
+whyred_poll(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want)
+{
+	return whyred_poll_n(base, off, mask, want, 100);
+}
+
+static void dump_ldo(const char *when);
+
+static void
+step1_reads(void)
+{
+	uint32_t ahb;
+
+	whyred_announce("step 1: read GCC GPU branches (read only)");
+	ahb = rd(gcc, GCC_GPU_CFG_AHB);
+	printf("WHYRED GPU: GCC cfg_ahb %08x bimc_gfx %08x gcc_bimc_gfx %08x "
+	    "gpll0_vote %08x\n", ahb, rd(gcc, GCC_GPU_BIMC_GFX),
+	    rd(gcc, GCC_BIMC_GFX), rd(gcc, GCC_GPLL0_VOTE));
+	if (ahb & CBCR_OFF) {
+		printf("WHYRED GPU: gcc_gpu_cfg_ahb_clk is OFF, GPUCC not read "
+		    "(it would be an unclocked access)\n");
+		return;
+	}
+	whyred_announce("step 1: read GPUCC (AHB clock is on)");
+	printf("WHYRED GPU: pll0 mode %08x pll1 mode %08x\n",
+	    rd(gpucc, CC_GPU_PLL0_MODE), rd(gpucc, CC_GPU_PLL1_MODE));
+	printf("WHYRED GPU: CX gdscr %08x hwctrl %08x GX gdscr %08x clamp %08x\n",
+	    rd(gpucc, CC_CX_GDSCR), rd(gpucc, CC_CX_GDS_HW_CTRL),
+	    rd(gpucc, CC_GX_GDSCR), rd(gpucc, CC_GX_CLAMP_IO));
+	printf("WHYRED GPU: gfx3d clk %08x rcg cmd %08x cfg %08x; rbbmtimer clk "
+	    "%08x rcg %08x; rbcpr clk %08x rcg %08x; cx_gfx3d %08x\n",
+	    rd(gpucc, CC_GFX3D_CLK), rd(gpucc, CC_GFX3D_RCG_CMD),
+	    rd(gpucc, CC_GFX3D_RCG_CFG), rd(gpucc, CC_RBBMTIMER_CLK),
+	    rd(gpucc, CC_RBBMTIMER_RCG_CMD), rd(gpucc, CC_RBCPR_CLK),
+	    rd(gpucc, CC_RBCPR_RCG_CMD), rd(gpucc, CC_CX_GFX3D_CLK));
+	dump_ldo("step 1");
+}
+
+static void
+vote_branch(const char *name, uint32_t off)
+{
+	uint32_t v = rd(gcc, off);
+	printf("WHYRED GPU: %s before %08x\n", name, v);
+	wr(gcc, off, v | CBCR_EN);
+	v = whyred_poll(gcc, off, CBCR_OFF, 0);
+	printf("WHYRED GPU: %s after %08x (%s)\n", name, v,
+	    (v & CBCR_OFF) ? "STILL OFF" : "on");
+}
+
+static void
+step2_votes(void)
+{
+	whyred_announce("step 2: vote gcc_gpu_bimc_gfx_clk and gcc_bimc_gfx_clk");
+	vote_branch("gpu_bimc_gfx", GCC_GPU_BIMC_GFX);
+	vote_branch("bimc_gfx", GCC_BIMC_GFX);
+}
+
+static int
+gdsc_on_n(const char *name, uint32_t off, int polls)
+{
+	uint32_t v = rd(gpucc, off);
+
+	if (v & GDSC_PWR_ON) {
+		printf("WHYRED GPU: %s GDSC already on (%08x)\n", name, v);
+		return 0;
+	}
+	printf("WHYRED GPU: %s GDSC off (%08x), clearing SW_COLLAPSE\n", name, v);
+	wr(gpucc, off, v & ~GDSC_COLLAPSE);
+	v = whyred_poll_n(gpucc, off, GDSC_PWR_ON, GDSC_PWR_ON, polls);
+	printf("WHYRED GPU: %s GDSC now %08x (%s)\n", name, v,
+	    (v & GDSC_PWR_ON) ? "on" : "STILL OFF");
+	return (v & GDSC_PWR_ON) ? 0 : EIO;
+}
+
+static int
+gdsc_on(const char *name, uint32_t off)
+{
+	return gdsc_on_n(name, off, 100);
+}
+
+static int
+step3_cx(void)
+{
+	if (rd(gcc, GCC_GPU_CFG_AHB) & CBCR_OFF) {
+		return EIO;
+	}
+	whyred_announce("step 3: CX GDSC on");
+	return gdsc_on("CX", CC_CX_GDSCR);
+}
+
+static void
+dump_gpu(void)
+{
+	printf("WHYRED GPU: RBBM_STATUS %08x STATUS3 %08x INT_0 %08x AHB_ERR %08x\n",
+	    rd(gpu, A5_RBBM_STATUS), rd(gpu, A5_RBBM_STATUS3),
+	    rd(gpu, A5_RBBM_INT_0_STATUS), rd(gpu, A5_RBBM_AHB_ERR_STATUS));
+	printf("WHYRED GPU: SECVID_TRUST_CNTL %08x CLOCK_CNTL %08x SW_RESET %08x "
+	    "CP_RB_BASE %08x CP_RB_CNTL %08x\n", rd(gpu, A5_RBBM_SECVID_TRUST),
+	    rd(gpu, A5_RBBM_CLOCK_CNTL), rd(gpu, A5_RBBM_SW_RESET_CMD),
+	    rd(gpu, A5_CP_RB_BASE), rd(gpu, A5_CP_RB_CNTL));
+}
+
+static void
+dump_ldo(const char *when)
+{
+	printf("WHYRED GPU: gfx ldo (%s): atest %08x cfg0 %08x cfg1 %08x cfg2 %08x "
+	    "ld %08x vreftest %08x vref %08x\n", when, rd(gpucc, CC_LDO),
+	    rd(gpucc, CC_LDO + 0x4), rd(gpucc, CC_LDO + 0x8),
+	    rd(gpucc, CC_LDO + 0xc), rd(gpucc, CC_LDO + 0x10),
+	    rd(gpucc, CC_LDO + 0x14), rd(gpucc, CC_LDO + 0x18));
+	printf("WHYRED GPU: gfx ldo (%s): pwrswitch_ctrl %08x status1 %08x "
+	    "pwrswitch_status %08x\n", when, rd(gpucc, CC_LDO_PWRSWITCH_CTRL),
+	    rd(gpucc, CC_LDO_STATUS1), rd(gpucc, CC_LDO_PWRSWITCH_STATUS));
+}
+
+/*
+ * The GX power domain is fed through the GFX LDO/head-switch block. Put it in
+ * BHS mode under GDSC control, the same bit sequence the vendor regulator
+ * runs on enable (msm_gfx_ldo.c: enable_bhs_mode, behaviour reference only).
+ */
+static void
+ldo_bhs_mode(void)
+{
+	uint32_t ctl = rd(gpucc, CC_LDO_PWRSWITCH_CTRL);
+
+	ctl |= LDO_UNDER_SW_CTRL;
+	wr(gpucc, CC_LDO_PWRSWITCH_CTRL, ctl);
+	ctl &= ~LDO_PWR_SRC_SEL;
+	wr(gpucc, CC_LDO_PWRSWITCH_CTRL, ctl);
+	ctl &= ~LDO_CPR_BYPASS;
+	wr(gpucc, CC_LDO_PWRSWITCH_CTRL, ctl);
+	ctl &= ~LDO_BHS_EN_FEW;
+	wr(gpucc, CC_LDO_PWRSWITCH_CTRL, ctl);
+	ctl &= ~LDO_BHS_EN_REST;
+	wr(gpucc, CC_LDO_PWRSWITCH_CTRL, ctl);
+	ctl &= ~LDO_BHS_UNDER_SW;
+	wr(gpucc, CC_LDO_PWRSWITCH_CTRL, ctl);
+}
+
+static void
+step4_gx(void)
+{
+	uint32_t v, ldo_ctl_saved;
+
+	/*
+	 * Run 3 of the ladder (0211): the GX GDSC left the off state
+	 * (GDSCR 08222000) but never reported PWR_ON. The DT marks it
+	 * qcom,force-enable-root-clk with core_root_clk = the GFX3D RCG, which
+	 * was still ROOT_OFF. Turn the root on first; its source is XO (cfg 0,
+	 * 19.2 MHz), no PLL and no rail involved.
+	 */
+	whyred_announce("step 4: force the GFX3D RCG root on (XO source)");
+	v = rd(gpucc, CC_GFX3D_RCG_CMD);
+	printf("WHYRED GPU: gfx3d rcg cmd before %08x cfg %08x\n", v,
+	    rd(gpucc, CC_GFX3D_RCG_CFG));
+	wr(gpucc, CC_GFX3D_RCG_CMD, v | RCG_ROOT_EN);
+	v = whyred_poll(gpucc, CC_GFX3D_RCG_CMD, RCG_ROOT_OFF, 0);
+	printf("WHYRED GPU: gfx3d rcg cmd after %08x (%s)\n", v,
+	    (v & RCG_ROOT_OFF) ? "root STILL OFF" : "root on");
+	dump_ldo("before");
+	whyred_announce("step 4: put the GFX LDO block in BHS mode under GDSC control");
+	ldo_ctl_saved = rd(gpucc, CC_LDO_PWRSWITCH_CTRL);
+	ldo_bhs_mode();
+	dump_ldo("after bhs");
+	/*
+	 * Run 5 of the ladder (0211): the LDO bits were already in BHS
+	 * state and the GX GDSC still stayed at 08222000. The vendor GDSC
+	 * driver does three more things BEFORE it clears SW_COLLAPSE
+	 * (gdsc-regulator.c, behaviour reference):
+	 * pulse the GX block reset (sw-reset = GPUCC+0x1090 bit 0), pulse the
+	 * AON/GMEM reset (domain-addr = GPUCC+0x130 bit 4, reset-aon-logic) and
+	 * release the GMEM clamp (same register, bit 0). Until now the clamp was
+	 * only released after the power-up that never completed.
+	 */
+	whyred_announce("step 4: GX block reset pulse, AON reset pulse, release clamp");
+	v = rd(gpucc, CC_GX_BCR);
+	printf("WHYRED GPU: GX bcr %08x clamp/domain %08x\n", v,
+	    rd(gpucc, CC_GX_CLAMP_IO));
+	wr(gpucc, CC_GX_BCR, v | 1u);
+	for (int i = 0; i < 20; i++) {
+		(void)rd(gpucc, CC_GX_GDSCR);
+	}
+	wr(gpucc, CC_GX_BCR, v & ~1u);
+	v = rd(gpucc, CC_GX_CLAMP_IO);
+	wr(gpucc, CC_GX_CLAMP_IO, v | GX_GMEM_RESET);
+	for (int i = 0; i < 20; i++) {
+		(void)rd(gpucc, CC_GX_GDSCR);
+	}
+	wr(gpucc, CC_GX_CLAMP_IO, v & ~GX_GMEM_RESET);
+	wr(gpucc, CC_GX_CLAMP_IO, rd(gpucc, CC_GX_CLAMP_IO) & ~1u);
+	printf("WHYRED GPU: GX bcr %08x clamp/domain %08x\n", rd(gpucc, CC_GX_BCR),
+	    rd(gpucc, CC_GX_CLAMP_IO));
+	whyred_announce("step 4: GX GDSC on");
+	if (gdsc_on_n("GX", CC_GX_GDSCR, 300)) {
+		whyred_wait(1000);
+		printf("WHYRED GPU: GX after 1 more s: gdscr %08x cfg(0x1098) %08x\n",
+		    rd(gpucc, CC_GX_GDSCR), rd(gpucc, CC_GFX3D_CLK));
+		/* leave the domain as found: collapse it, drop the forced root,
+		 * restore the LDO block */
+		wr(gpucc, CC_LDO_PWRSWITCH_CTRL, ldo_ctl_saved);
+		wr(gpucc, CC_GX_CLAMP_IO, rd(gpucc, CC_GX_CLAMP_IO) | 1u);
+		wr(gpucc, CC_GX_GDSCR, rd(gpucc, CC_GX_GDSCR) | GDSC_COLLAPSE);
+		wr(gpucc, CC_GFX3D_RCG_CMD,
+		    rd(gpucc, CC_GFX3D_RCG_CMD) & ~RCG_ROOT_EN);
+		whyred_wait(100);
+		printf("WHYRED GPU: GX collapsed again: gdscr %08x rcg %08x\n",
+		    rd(gpucc, CC_GX_GDSCR), rd(gpucc, CC_GFX3D_RCG_CMD));
+		return;
+	}
+	v = rd(gpucc, CC_GX_CLAMP_IO);
+	printf("WHYRED GPU: GMEM clamp before %08x, clearing bit 0\n", v);
+	wr(gpucc, CC_GX_CLAMP_IO, v & ~1u);
+	whyred_announce("step 4: enable gfx3d and rbbmtimer branches");
+	for (int i = 0; i < 2; i++) {
+		uint32_t off = i ? CC_RBBMTIMER_CLK : CC_GFX3D_CLK;
+		v = rd(gpucc, off);
+		wr(gpucc, off, v | CBCR_EN);
+		v = whyred_poll(gpucc, off, CBCR_OFF, 0);
+		printf("WHYRED GPU: %s clk %08x (%s)\n", i ? "rbbmtimer" : "gfx3d",
+		    v, (v & CBCR_OFF) ? "STILL OFF" : "on");
+	}
+	whyred_announce("step 4: READ the GPU block at 0x05000000");
+	dump_gpu();
+	gx_on = 1;
+	printf("WHYRED GPU: step 4 done, the GPU block answered\n");
+}
+
+/*
+ * Step 5: does the SDM660 TrustZone take our SCM call, and does it know the
+ * GPU zap shader (PAS id 13)? Questions only, no state change. The calling
+ * convention is the one 0113 uses for the modem (SMC64, owner SIP, yielding
+ * call, resumed while x0 == 1); Linux qcom_scm-smc.c as behaviour reference.
+ */
+#define SCM_FN(svc, cmd)        (0x42000000u | ((uint32_t)(svc) << 8) | (uint32_t)(cmd))
+#define SCM_SVC_INFO            0x06
+#define SCM_INFO_IS_CALL_AVAIL  0x01
+#define SCM_SVC_PIL             0x02
+#define PIL_IS_SUPPORTED        0x07
+
+static uint64_t
+whyred_scm(uint32_t fn, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c,
+    uint64_t *res1)
+{
+	register uint64_t x0 __asm__("x0") = fn, x1 __asm__("x1") = arginfo,
+	    x2 __asm__("x2") = a, x3 __asm__("x3") = b, x4 __asm__("x4") = c,
+	    x5 __asm__("x5") = 0, x6 __asm__("x6") = 0, x7 __asm__("x7") = 0;
+
+	for (int n = 0; n < 1000; n++) {
+		__asm__ volatile ("smc #0"
+		    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4),
+		      "+r"(x5), "+r"(x6), "+r"(x7)
+		    :
+		    : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+		      "x16", "x17", "memory");
+		if (x0 != 1) {
+			break;
+		}
+		/* INTERRUPTED: resume with the session id the secure side gave */
+		x0 = 1;
+		x1 = arginfo;
+		x2 = a;
+		x3 = b;
+		x4 = c;
+		x5 = 0;
+		x7 = 0;
+	}
+	*res1 = x1;
+	return x0;
+}
+
+static void
+step5_scm(void)
+{
+	static const uint32_t ids[] = { 13, 4, 99 };
+	static const char *const names[] = { "gpu zap", "modem (reference)",
+	    "unused (contrast)" };
+	uint64_t ret, res = 0;
+
+	whyred_announce("step 5: SCM INFO is_call_available(PIL IS_SUPPORTED)");
+	ret = whyred_scm(SCM_FN(SCM_SVC_INFO, SCM_INFO_IS_CALL_AVAIL), 1,
+	    SCM_FN(SCM_SVC_PIL, PIL_IS_SUPPORTED), 0, 0, &res);
+	printf("WHYRED GPU: SCM is_call_available: ret %llx res %llx\n",
+	    (unsigned long long)ret, (unsigned long long)res);
+	for (unsigned i = 0; i < sizeof(ids) / sizeof(ids[0]); i++) {
+		whyred_announce("step 5: SCM PIL IS_SUPPORTED for the next id");
+		ret = whyred_scm(SCM_FN(SCM_SVC_PIL, PIL_IS_SUPPORTED), 1, ids[i], 0, 0,
+		    &res);
+		printf("WHYRED GPU: SCM PAS id %u (%s) supported: ret %llx res %llx\n",
+		    ids[i], names[i], (unsigned long long)ret,
+		    (unsigned long long)res);
+	}
+}
+
+/*
+ * Step 6: load the GPU zap shader through TrustZone. Same sequence the vendor
+ * PIL driver runs (Linux qcom_mdt_load + qcom_scm_pas_*, behaviour reference):
+ *   INIT_IMAGE   metadata = a512_zap.mdt (ELF header + hash segment), in a
+ *                physically contiguous non-secure buffer
+ *   MEM_SETUP    the region the image will be placed in (relocatable image)
+ *   copy         the PT_LOAD segment (a512_zap.b02) into that region
+ *   AUTH_AND_RESET
+ * After AUTH_AND_RESET the region belongs to the secure side: it is kept
+ * allocated (permanent) and never touched again.
+ */
+#define GPU_FW_DIR              "/usr/share/firmware/whyred/gpu/"
+#define PAS_ID_GPU_ZAP          13
+#define PIL_INIT_IMAGE          0x01
+#define PIL_MEM_SETUP           0x02
+#define PIL_AUTH_RESET          0x05
+#define SCM_ARG_RW              2
+#define ZAP_META_MAX            0x2000u
+#define ZAP_CODE_MAX            0x10000u
+
+struct whyred_elf32_ehdr {
+	uint8_t  e_ident[16];
+	uint16_t e_type, e_machine;
+	uint32_t e_version, e_entry, e_phoff, e_shoff, e_flags;
+	uint16_t e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx;
+};
+
+struct whyred_elf32_phdr {
+	uint32_t p_type, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_flags,
+	    p_align;
+};
+
+static int
+whyred_alloc(vm_size_t size, vm_offset_t mask, vm_offset_t *va, uint64_t *pa)
+{
+	ppnum_t pn;
+
+	*va = 0;
+	if (kmem_alloc_contig(kernel_map, va, size, mask, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) !=
+	    KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	pn = pmap_find_phys(kernel_pmap, (addr64_t)*va);
+	if (pn == 0) {
+		return ENOMEM;
+	}
+	*pa = ptoa_64(pn);
+	return 0;
+}
+
+/* Read a whole file (at most max bytes) into buf; *len gets its size. */
+static int
+whyred_read_file(const char *name, void *buf, uint32_t max, uint32_t *len)
+{
+	char path[128];
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	int err, resid = 0;
+
+	snprintf(path, sizeof(path), "%s%s", GPU_FW_DIR, name);
+	err = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (err) {
+		printf("WHYRED GPU: open %s failed: %d\n", path, err);
+		return err;
+	}
+	err = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)max, 0, UIO_SYSSPACE,
+	    IO_NODELOCKED, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	(void)vnode_close(vp, FREAD, ctx);
+	if (err) {
+		printf("WHYRED GPU: read %s failed: %d\n", path, err);
+		return err;
+	}
+	*len = max - (uint32_t)resid;
+	return 0;
+}
+
+static void
+step6_zap(void)
+{
+	vm_offset_t meta = 0, code = 0, region = 0;
+	uint64_t meta_pa = 0, code_pa = 0, region_pa = 0, ret, res = 0;
+	uint32_t meta_len = 0, code_len = 0, fw_len = 0;
+	const struct whyred_elf32_ehdr *eh;
+	const struct whyred_elf32_phdr *ph, *load = NULL;
+	uint32_t min_addr, max_addr, size;
+
+	whyred_announce("step 6: read the zap firmware from the root filesystem");
+	if (whyred_alloc(ZAP_META_MAX, PAGE_MASK, &meta, &meta_pa) ||
+	    whyred_alloc(ZAP_CODE_MAX, PAGE_MASK, &code, &code_pa)) {
+		printf("WHYRED GPU: no contiguous memory for the zap image\n");
+		return;
+	}
+	if (whyred_read_file("a512_zap.mdt", (void *)meta, ZAP_META_MAX, &meta_len) ||
+	    whyred_read_file("a512_zap.b02", (void *)code, ZAP_CODE_MAX, &code_len)) {
+		return;
+	}
+	/* The microcode is only checked and counted here; it is loaded later. */
+	if (whyred_read_file("a530_pm4.fw", (void *)(code + 0x8000), 0x8000,
+	    &fw_len) == 0) {
+		printf("WHYRED GPU: a530_pm4.fw %u bytes\n", fw_len);
+	}
+	printf("WHYRED GPU: a512_zap.mdt %u bytes, a512_zap.b02 %u bytes, "
+	    "meta pa %llx\n", meta_len, code_len, (unsigned long long)meta_pa);
+	eh = (const struct whyred_elf32_ehdr *)meta;
+	if (meta_len < sizeof(*eh) || memcmp(eh->e_ident, "\177ELF", 4) != 0 ||
+	    eh->e_phentsize != sizeof(*ph) || eh->e_phnum == 0 ||
+	    eh->e_phoff + (uint32_t)eh->e_phnum * sizeof(*ph) > meta_len) {
+		printf("WHYRED GPU: a512_zap.mdt is not the expected ELF\n");
+		return;
+	}
+	ph = (const struct whyred_elf32_phdr *)(meta + eh->e_phoff);
+	min_addr = 0xffffffffu;
+	max_addr = 0;
+	for (unsigned i = 0; i < eh->e_phnum; i++) {
+		if (ph[i].p_type != 1 || ph[i].p_memsz == 0) {
+			continue;
+		}
+		if (ph[i].p_paddr < min_addr) {
+			min_addr = ph[i].p_paddr;
+		}
+		if (ph[i].p_paddr + ph[i].p_memsz > max_addr) {
+			max_addr = ph[i].p_paddr + ph[i].p_memsz;
+		}
+		load = &ph[i];
+	}
+	if (load == NULL || load->p_filesz != code_len ||
+	    load->p_memsz < load->p_filesz) {
+		printf("WHYRED GPU: zap segment does not match a512_zap.b02\n");
+		return;
+	}
+	min_addr &= ~0xfffu;
+	max_addr = (max_addr + 0xfffu) & ~0xfffu;
+	size = max_addr - min_addr;
+	printf("WHYRED GPU: zap region 0x%x..0x%x (%u bytes), load offset 0x%x\n",
+	    min_addr, max_addr, size, load->p_paddr - min_addr);
+	if (size > 0x100000 ||
+	    (whyred_alloc(size, 0xfffff, &region, &region_pa) &&
+	    whyred_alloc(size, PAGE_MASK, &region, &region_pa))) {
+		printf("WHYRED GPU: no contiguous region for the zap\n");
+		return;
+	}
+	printf("WHYRED GPU: zap region pa %llx, SECVID_TRUST_CNTL before %08x\n",
+	    (unsigned long long)region_pa, gx_on ? rd(gpu, A5_RBBM_SECVID_TRUST) : 0);
+
+	flush_dcache64((addr64_t)meta_pa, meta_len, TRUE);
+	whyred_announce("step 6: SCM PIL INIT_IMAGE (metadata)");
+	ret = whyred_scm(SCM_FN(SCM_SVC_PIL, PIL_INIT_IMAGE),
+	    2 | (SCM_ARG_RW << 6), PAS_ID_GPU_ZAP, meta_pa, 0, &res);
+	printf("WHYRED GPU: init_image: ret %llx res %llx\n", (unsigned long long)ret,
+	    (unsigned long long)res);
+	if (ret != 0) {
+		return;
+	}
+	whyred_announce("step 6: SCM PIL MEM_SETUP (region)");
+	ret = whyred_scm(SCM_FN(SCM_SVC_PIL, PIL_MEM_SETUP), 3, PAS_ID_GPU_ZAP,
+	    region_pa, size, &res);
+	printf("WHYRED GPU: mem_setup: ret %llx res %llx\n", (unsigned long long)ret,
+	    (unsigned long long)res);
+	if (ret != 0) {
+		return;
+	}
+	memcpy((void *)(region + (load->p_paddr - min_addr)), (void *)code,
+	    code_len);
+	flush_dcache64((addr64_t)region_pa, size, TRUE);
+	whyred_announce("step 6: SCM PIL AUTH_AND_RESET (loads the zap)");
+	ret = whyred_scm(SCM_FN(SCM_SVC_PIL, PIL_AUTH_RESET), 1, PAS_ID_GPU_ZAP, 0,
+	    0, &res);
+	printf("WHYRED GPU: auth_and_reset: ret %llx res %llx\n",
+	    (unsigned long long)ret, (unsigned long long)res);
+	whyred_wait(100);
+	if (gx_on) {
+		printf("WHYRED GPU: after the zap: RBBM_STATUS %08x SECVID_TRUST_CNTL "
+		    "%08x\n", rd(gpu, A5_RBBM_STATUS), rd(gpu, A5_RBBM_SECVID_TRUST));
+	}
+}
+
+/*
+ * Step 7: read-only look at the GPU's own SMMU (kgsl-smmu-v2, ARM SMMUv2
+ * register layout). The CP fetches microcode and the ring through it, so we
+ * need to know whether it translates, is in bypass, or is locked by the
+ * secure side. Nothing is written.
+ */
+#define SMMU_PA                 0x05040000u
+#define SMMU_SIZE               0x10000u
+
+static vm_offset_t smmu_va;
+
+static void
+step7_smmu(void)
+{
+	vm_offset_t smmu;
+	uint32_t idr0, idr1, idr2, idr7, pgsz, npage, cbbase;
+
+	smmu = ml_io_map(SMMU_PA, SMMU_SIZE);
+	if (smmu == 0) {
+		printf("WHYRED GPU: SMMU map failed\n");
+		return;
+	}
+	whyred_announce("step 7: READ the SMMU global registers");
+	idr0 = rd(smmu, 0x20);
+	idr1 = rd(smmu, 0x24);
+	idr2 = rd(smmu, 0x28);
+	idr7 = rd(smmu, 0x3c);
+	printf("WHYRED GPU: SMMU sCR0 %08x sCR1 %08x sCR2 %08x sACR %08x\n",
+	    rd(smmu, 0x0), rd(smmu, 0x4), rd(smmu, 0x8), rd(smmu, 0x10));
+	printf("WHYRED GPU: SMMU IDR0 %08x IDR1 %08x IDR2 %08x IDR7 %08x\n", idr0,
+	    idr1, idr2, idr7);
+	pgsz = (idr1 & (1u << 31)) ? 0x10000u : 0x1000u;
+	npage = 1u << (((idr1 >> 28) & 7) + 1);
+	cbbase = (npage * pgsz) / 2;
+	printf("WHYRED GPU: SMMU page size %x, %u pages, %u context banks, "
+	    "%u stream-mapping groups, CB base +%x\n", pgsz, npage,
+	    idr1 & 0xff, (idr0 >> 0) & 0xff, cbbase);
+
+	whyred_announce("step 7: READ stream mapping groups 0..3");
+	for (uint32_t i = 0; i < 4; i++) {
+		printf("WHYRED GPU: SMMU SMR%u %08x S2CR%u %08x\n", i,
+		    rd(smmu, 0x800 + 4 * i), i, rd(smmu, 0xc00 + 4 * i));
+	}
+	if (cbbase + 4 * pgsz > SMMU_SIZE) {
+		printf("WHYRED GPU: context banks are outside the mapped block\n");
+		return;
+	}
+	whyred_announce("step 7: READ context banks 0 and 4 (1..3 hang the reader)");
+	for (uint32_t cb = 0; cb < 5; cb += 4) {
+		vm_offset_t b = smmu + cbbase + cb * pgsz;
+		printf("WHYRED GPU: CB%u SCTLR %08x TTBR0 %08x%08x TCR %08x FSR %08x "
+		    "FAR %08x\n", cb, rd(b, 0x0), rd(b, 0x24), rd(b, 0x20),
+		    rd(b, 0x30), rd(b, 0x58), rd(b, 0x60));
+	}
+	smmu_va = smmu;
+}
+
+/*
+ * Step 8: let the GPU's stream (SID 0) through the SMMU untranslated, so the
+ * CP can fetch microcode and the ring by physical address (S2CR type BYPASS).
+ * SMR0 matches only ID 0; no other master uses this SMMU's stream 0.
+ */
+static void
+step8_smmu_bypass(void)
+{
+	uint32_t smr, s2cr;
+
+	if (smmu_va == 0) {
+		return;
+	}
+	whyred_announce("step 8: WRITE SMR0 (valid, ID 0) and S2CR0 (bypass)");
+	wr(smmu_va, 0x800, (1u << 31) | 0u);
+	wr(smmu_va, 0xc00, (1u << 16) | 0u);
+	smr = rd(smmu_va, 0x800);
+	s2cr = rd(smmu_va, 0xc00);
+	printf("WHYRED GPU: SMMU SMR0 now %08x S2CR0 now %08x (%s)\n", smr, s2cr,
+	    (smr == ((1u << 31)) && ((s2cr >> 16) & 3) == 1) ? "bypass stuck" :
+	    "did not take");
+}
+
+/*
+ * Step 9: the SMMU turned the bypass request into "fault", so translate: give
+ * context bank 4 (gfx3d_user, DT gpu-offset 0x48000) a stage 1 AArch64 table
+ * that maps the first 4 GB 1:1 (four 1 GB blocks, normal write-back memory),
+ * and point stream 0 at it. The CP then fetches microcode and the ring by
+ * physical address through the table. Register layout: ARM SMMUv2.
+ */
+#define SMMU_CB                 4u
+#define SMMU_CBAR(cb)           (0x1000u + 4u * (cb))
+#define SMMU_CBA2R(cb)          (0x8000u + 4u * (cb))
+#define CB_SCTLR                0x00u
+#define CB_TCR2                 0x10u
+#define CB_TTBR0                0x20u
+#define CB_TCR                  0x30u
+#define CB_MAIR0                0x38u
+#define CB_FSR                  0x58u
+#define CB_TLBIALL              0x618u
+#define CB_TLBSYNC              0x7f0u
+#define CB_TLBSTATUS            0x7f4u
+
+static uint64_t smmu_pt_pa;
+
+static void
+step9_smmu_s1(void)
+{
+	vm_offset_t pt = 0, cb;
+	uint64_t pa = 0;
+	uint32_t pgsz = 0x1000, cbbase = 0x4000;
+
+	if (smmu_va == 0) {
+		return;
+	}
+	if (whyred_alloc(0x1000, PAGE_MASK, &pt, &pa)) {
+		printf("WHYRED GPU: no page for the SMMU table\n");
+		return;
+	}
+	for (unsigned i = 0; i < 4; i++) {
+		/* 1 GB block: VA = PA, AF, inner shareable, attr index 0, valid */
+		((volatile uint64_t *)pt)[i] = ((uint64_t)i << 30) | (1ull << 10) |
+		    (3ull << 8) | 1ull;
+	}
+	flush_dcache64((addr64_t)pa, 0x1000, TRUE);
+	smmu_pt_pa = pa;
+	cb = smmu_va + cbbase + SMMU_CB * pgsz;
+
+	whyred_announce("step 9: WRITE context bank 4 (stage 1, identity table)");
+	wr(smmu_va, SMMU_CBA2R(SMMU_CB), 1u);                  /* VA64 */
+	wr(smmu_va, SMMU_CBAR(SMMU_CB), 1u << 16);             /* S1 translate, S2 bypass */
+	wr(cb, CB_TCR2, 0x1u);                                 /* 36-bit output */
+	wr(cb, CB_TCR, 25u | (1u << 8) | (1u << 10) | (3u << 12)); /* 39-bit VA, 4K, WB, inner */
+	wr(cb, CB_MAIR0, 0xffu);
+	wr(cb, CB_TTBR0, (uint32_t)pa);
+	wr(cb, CB_TTBR0 + 4, (uint32_t)(pa >> 32));
+	wr(cb, CB_FSR, 0xffffffffu);
+	wr(cb, CB_TLBIALL, 0);
+	wr(cb, CB_TLBSYNC, 0);
+	for (int i = 0; i < 1000 && (rd(cb, CB_TLBSTATUS) & 1); i++) {
+		whyred_wait(1);
+	}
+	printf("WHYRED GPU: CB4 before enable: CBAR %08x CBA2R %08x TCR %08x TCR2 %08x "
+	    "TTBR0 %08x%08x MAIR0 %08x\n", rd(smmu_va, SMMU_CBAR(SMMU_CB)),
+	    rd(smmu_va, SMMU_CBA2R(SMMU_CB)), rd(cb, CB_TCR), rd(cb, CB_TCR2),
+	    rd(cb, CB_TTBR0 + 4), rd(cb, CB_TTBR0), rd(cb, CB_MAIR0));
+
+	whyred_announce("step 9: enable context bank 4 and map stream 0 to it");
+	/* M, TRE, AFE, CFRE, CFIE: translate, report faults, no stalling */
+	wr(cb, CB_SCTLR, (1u << 0) | (1u << 1) | (1u << 2) | (1u << 5) | (1u << 6));
+	wr(smmu_va, 0xc00, SMMU_CB);                           /* S2CR0: translate via CB4 */
+	wr(smmu_va, 0x800, 1u << 31);                          /* SMR0: valid, ID 0 */
+	printf("WHYRED GPU: CB4 SCTLR %08x FSR %08x; SMR0 %08x S2CR0 %08x (%s)\n",
+	    rd(cb, CB_SCTLR), rd(cb, CB_FSR), rd(smmu_va, 0x800),
+	    rd(smmu_va, 0xc00),
+	    (rd(smmu_va, 0xc00) & 0x3ffffu) == SMMU_CB ? "stream 0 -> CB4" :
+	    "did not take");
+}
+
+/*
+ * Step 10: microcode and ring, CP still halted. Put the PM4 (ME) and PFP
+ * images in physically contiguous buffers (the firmware file minus its first
+ * dword, as the vendor driver does), point the CP at them, allocate the ring
+ * and the read-pointer shadow, program the ring registers, read everything
+ * back. The CP is not started here. All addresses are PA = GPU VA through the
+ * identity table of step 9.
+ */
+#define A5_CP_RB_BASE           (0x0800u * 4)
+#define A5_CP_RB_CNTL           (0x0802u * 4)
+#define A5_CP_RB_RPTR_ADDR      (0x0804u * 4)
+#define A5_CP_RB_RPTR           (0x0806u * 4)
+#define A5_CP_RB_WPTR           (0x0807u * 4)
+#define A5_CP_CNTL              (0x0831u * 4)
+#define A5_CP_PFP_ME_CNTL       (0x0832u * 4)
+#define A5_CP_PFP_INSTR_BASE    (0x0835u * 4)
+#define A5_CP_ME_INSTR_BASE     (0x0838u * 4)
+#define RING_BYTES              0x8000u
+#define UCODE_BYTES             0x5000u
+
+static uint64_t ring_pa, rptr_pa, fence_pa, ucode_pm4_pa, ucode_pfp_pa;
+static vm_offset_t ring_va, rptr_va;
+
+static int
+whyred_load_ucode(const char *name, uint64_t *pa)
+{
+	vm_offset_t va = 0;
+	uint32_t len = 0;
+
+	if (whyred_alloc(UCODE_BYTES, PAGE_MASK, &va, pa) ||
+	    whyred_read_file(name, (void *)va, UCODE_BYTES, &len)) {
+		return -1;
+	}
+	if (len < 8 || len > UCODE_BYTES) {
+		printf("WHYRED GPU: %s has an unexpected size %u\n", name, len);
+		return -1;
+	}
+	memmove((void *)va, (void *)(va + 4), len - 4);
+	flush_dcache64((addr64_t)*pa, UCODE_BYTES, TRUE);
+	printf("WHYRED GPU: %s: %u bytes of microcode at pa %llx\n", name, len - 4,
+	    (unsigned long long)*pa);
+	return 0;
+}
+
+static void
+step10_ucode_ring(void)
+{
+	uint64_t pm4_pa, pfp_pa;
+
+	if (!gx_on || smmu_pt_pa == 0) {
+		printf("WHYRED GPU: step 10 needs the GX power-up and the SMMU table\n");
+		return;
+	}
+	whyred_announce("step 10: read the microcode files");
+	if (whyred_load_ucode("a530_pm4.fw", &pm4_pa) ||
+	    whyred_load_ucode("a530_pfp.fw", &pfp_pa) ||
+	    whyred_alloc(RING_BYTES, PAGE_MASK, &ring_va, &ring_pa) ||
+	    whyred_alloc(0x1000, PAGE_MASK, &rptr_va, &rptr_pa)) {
+		printf("WHYRED GPU: step 10: buffers not available\n");
+		return;
+	}
+	fence_pa = rptr_pa + 0x100;
+	ucode_pm4_pa = pm4_pa;
+	ucode_pfp_pa = pfp_pa;
+	printf("WHYRED GPU: ring pa %llx, rptr shadow pa %llx, fence pa %llx\n",
+	    (unsigned long long)ring_pa, (unsigned long long)rptr_pa,
+	    (unsigned long long)fence_pa);
+	printf("WHYRED GPU: CP_CNTL %08x CP_PFP_ME_CNTL %08x before\n",
+	    rd(gpu, A5_CP_CNTL), rd(gpu, A5_CP_PFP_ME_CNTL));
+
+	whyred_announce("step 10: WRITE CP microcode base and ring registers");
+	wr(gpu, A5_CP_PFP_INSTR_BASE, (uint32_t)pfp_pa);
+	wr(gpu, A5_CP_PFP_INSTR_BASE + 4, (uint32_t)(pfp_pa >> 32));
+	wr(gpu, A5_CP_ME_INSTR_BASE, (uint32_t)pm4_pa);
+	wr(gpu, A5_CP_ME_INSTR_BASE + 4, (uint32_t)(pm4_pa >> 32));
+	/* ring: BUFSZ = log2(bytes/8) in bits 5:0, BLKSZ = log2(32/8) in bits 13:8 */
+	wr(gpu, A5_CP_RB_CNTL, 12u | (2u << 8));
+	wr(gpu, A5_CP_RB_BASE, (uint32_t)ring_pa);
+	wr(gpu, A5_CP_RB_BASE + 4, (uint32_t)(ring_pa >> 32));
+	wr(gpu, A5_CP_RB_RPTR_ADDR, (uint32_t)rptr_pa);
+	wr(gpu, A5_CP_RB_RPTR_ADDR + 4, (uint32_t)(rptr_pa >> 32));
+	printf("WHYRED GPU: PFP base %08x%08x ME base %08x%08x\n",
+	    rd(gpu, A5_CP_PFP_INSTR_BASE + 4), rd(gpu, A5_CP_PFP_INSTR_BASE),
+	    rd(gpu, A5_CP_ME_INSTR_BASE + 4), rd(gpu, A5_CP_ME_INSTR_BASE));
+	printf("WHYRED GPU: RB_CNTL %08x RB_BASE %08x%08x RPTR_ADDR %08x%08x RPTR %08x "
+	    "WPTR %08x\n", rd(gpu, A5_CP_RB_CNTL), rd(gpu, A5_CP_RB_BASE + 4),
+	    rd(gpu, A5_CP_RB_BASE), rd(gpu, A5_CP_RB_RPTR_ADDR + 4),
+	    rd(gpu, A5_CP_RB_RPTR_ADDR), rd(gpu, A5_CP_RB_RPTR),
+	    rd(gpu, A5_CP_RB_WPTR));
+}
+
+/*
+ * Step 11: start the command processor. Behaviour reference: Linux a5xx
+ * hw_init / me_init / flush (no code taken). Minimal subset: 64-bit address
+ * modes, secure-video block off, CP queue thresholds, un-halt PFP/ME, then
+ * packets through the ring: CP_ME_INIT, then CP_SET_SECURE_MODE(0), then a
+ * CP_MEM_WRITE to a fence word that the CPU reads back. Every submission is
+ * announced and the ladder stops at the first one the CP does not consume.
+ */
+#define A5_RBBM_INT_0_MASK      (0x0038u * 4)
+#define A5_CP_ROQ_THRESH_1      (0x081fu * 4)
+#define A5_CP_ROQ_THRESH_2      (0x0820u * 4)
+#define A5_CP_MEQ_THRESHOLDS    (0x0825u * 4)
+#define A5_CP_MERCIU_SIZE       (0x0826u * 4)
+#define A5_CP_CHICKEN_DBG       (0x0833u * 4)
+#define A5_CP_ADDR_MODE_CNTL    (0x0860u * 4)
+#define A5_SECVID_TSB_BASE_LO   (0xf800u * 4)
+#define A5_SECVID_TSB_SIZE      (0xf802u * 4)
+#define A5_SECVID_TSB_CNTL      (0xf803u * 4)
+#define A5_SECVID_TSB_ADDR_MODE (0xf810u * 4)
+#define RB_NO_UPDATE            (1u << 27)
+
+#define CP_NOP                  16u
+#define CP_ME_INIT              72u
+#define CP_MEM_WRITE            61u
+#define CP_SET_SECURE_MODE      102u
+
+static uint32_t ring_wptr;
+
+/* Odd parity bit of val, as the PM4 type 7 header wants it. */
+static uint32_t
+pm4_parity(uint32_t val)
+{
+	val ^= val >> 16;
+	val ^= val >> 8;
+	val ^= val >> 4;
+	return (0x9669u >> (val & 0xf)) & 1u;
+}
+
+static void
+ring_put(uint32_t v)
+{
+	((volatile uint32_t *)ring_va)[ring_wptr] = v;
+	ring_wptr = (ring_wptr + 1) % (RING_BYTES / 4);
+}
+
+static void
+ring_pkt7(uint32_t opcode, uint32_t cnt)
+{
+	ring_put(0x70000000u | (cnt & 0x3fff) | (pm4_parity(cnt) << 15) |
+	    ((opcode & 0x7f) << 16) | (pm4_parity(opcode) << 23));
+}
+
+/* Publish the packets and wait for the CP read pointer to catch up. */
+static int
+ring_submit(const char *what)
+{
+	uint32_t rptr = 0;
+
+	flush_dcache64((addr64_t)ring_pa, RING_BYTES, TRUE);
+	wr(gpu, A5_CP_RB_WPTR, ring_wptr);
+	for (int i = 0; i < 300; i++) {
+		rptr = rd(gpu, A5_CP_RB_RPTR);
+		if (rptr == ring_wptr) {
+			printf("WHYRED GPU: %s consumed: RPTR %u WPTR %u after %d ms\n",
+			    what, rptr, ring_wptr, i * 10);
+			return 0;
+		}
+		whyred_wait(10);
+	}
+	printf("WHYRED GPU: %s NOT consumed: RPTR %u WPTR %u, RBBM_STATUS %08x INT_0 "
+	    "%08x AHB_ERR %08x\n", what, rptr, ring_wptr, rd(gpu, A5_RBBM_STATUS),
+	    rd(gpu, A5_RBBM_INT_0_STATUS), rd(gpu, A5_RBBM_AHB_ERR_STATUS));
+	return -1;
+}
+
+static void
+step11_cp_start(void)
+{
+	volatile uint32_t *fence;
+
+	if (ring_va == 0 || ring_pa == 0) {
+		printf("WHYRED GPU: step 11 needs the ring of step 10\n");
+		return;
+	}
+	whyred_announce("step 11: WRITE the CP/RBBM setup registers");
+	wr(gpu, A5_SECVID_TSB_CNTL, 0);
+	wr(gpu, A5_SECVID_TSB_BASE_LO, 0);
+	wr(gpu, A5_SECVID_TSB_BASE_LO + 4, 0);
+	wr(gpu, A5_SECVID_TSB_SIZE, 0);
+	wr(gpu, A5_CP_ADDR_MODE_CNTL, 1);
+	wr(gpu, A5_SECVID_TSB_ADDR_MODE, 1);
+	wr(gpu, A5_CP_MEQ_THRESHOLDS, 0x40);
+	wr(gpu, A5_CP_MERCIU_SIZE, 0x400);
+	wr(gpu, A5_CP_ROQ_THRESH_2, 0x80000060);
+	wr(gpu, A5_CP_ROQ_THRESH_1, 0x40201b16);
+	wr(gpu, A5_CP_CHICKEN_DBG, 0x02000000);
+	wr(gpu, A5_RBBM_INT_0_MASK, 0);
+	wr(gpu, A5_CP_RB_CNTL, 12u | (2u << 8) | RB_NO_UPDATE);
+	printf("WHYRED GPU: RB_CNTL %08x CP_ADDR_MODE %08x\n", rd(gpu, A5_CP_RB_CNTL),
+	    rd(gpu, A5_CP_ADDR_MODE_CNTL));
+
+	whyred_announce("step 11: clear the PFP/ME halt");
+	wr(gpu, A5_CP_PFP_ME_CNTL, 0);
+	whyred_wait(50);
+	printf("WHYRED GPU: CP_PFP_ME_CNTL %08x RBBM_STATUS %08x RPTR %u WPTR %u\n",
+	    rd(gpu, A5_CP_PFP_ME_CNTL), rd(gpu, A5_RBBM_STATUS),
+	    rd(gpu, A5_CP_RB_RPTR), rd(gpu, A5_CP_RB_WPTR));
+
+	whyred_announce("step 11: submit CP_ME_INIT");
+	ring_pkt7(CP_ME_INIT, 8);
+	ring_put(0x0000002f);	/* max context */
+	ring_put(0x00000003);	/* multiple hardware contexts */
+	ring_put(0x20000000);	/* error detection */
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);		/* no microcode workarounds (a512) */
+	ring_put(0);
+	ring_put(0);
+	if (ring_submit("ME_INIT") != 0) {
+		return;
+	}
+
+	whyred_announce("step 11: submit CP_SET_SECURE_MODE(0)");
+	ring_pkt7(CP_SET_SECURE_MODE, 1);
+	ring_put(0);
+	if (ring_submit("SET_SECURE_MODE") != 0) {
+		return;
+	}
+	printf("WHYRED GPU: SECVID_TRUST_CNTL now %08x RBBM_STATUS %08x\n",
+	    rd(gpu, A5_RBBM_SECVID_TRUST), rd(gpu, A5_RBBM_STATUS));
+
+	whyred_announce("step 11: submit CP_MEM_WRITE (fence word)");
+	fence = (volatile uint32_t *)(rptr_va + 0x100);
+	*fence = 0;
+	flush_dcache64((addr64_t)fence_pa, 64, TRUE);
+	ring_pkt7(CP_MEM_WRITE, 3);
+	ring_put((uint32_t)fence_pa);
+	ring_put((uint32_t)(fence_pa >> 32));
+	ring_put(0xcafe0001u);
+	if (ring_submit("MEM_WRITE") != 0) {
+		return;
+	}
+	flush_dcache64((addr64_t)fence_pa, 64, TRUE);
+	printf("WHYRED GPU: fence word %08x (%s)\n", *fence,
+	    *fence == 0xcafe0001u ? "CP WROTE IT" : "not written");
+}
+
+/*
+ * Step 12: is the fence repeatable, and can the GPU be recovered from a hang
+ * without a reboot? (a) 16 fences with different values; (b) a deliberate
+ * hang: a CP_NOP whose length is larger than the data that follows swallows
+ * the next packet and leaves the CP waiting for the rest, so a fence queued
+ * behind it never lands; (c) RBBM software reset, the same bring-up again
+ * (microcode and ring registers, setup, un-halt, ME_INIT, secure mode off;
+ * the zap stays loaded), and a fence that must land again.
+ */
+#define A5_RBBM_SW_RESET_CMD    (0x0043u * 4)
+
+static int
+fence_test(uint32_t val, unsigned wait_ms)
+{
+	volatile uint32_t *fence = (volatile uint32_t *)(rptr_va + 0x100);
+
+	*fence = 0;
+	flush_dcache64((addr64_t)fence_pa, 64, TRUE);
+	ring_pkt7(CP_MEM_WRITE, 3);
+	ring_put((uint32_t)fence_pa);
+	ring_put((uint32_t)(fence_pa >> 32));
+	ring_put(val);
+	flush_dcache64((addr64_t)ring_pa, RING_BYTES, TRUE);
+	wr(gpu, A5_CP_RB_WPTR, ring_wptr);
+	for (unsigned i = 0; i < wait_ms / 5; i++) {
+		whyred_wait(5);
+		flush_dcache64((addr64_t)fence_pa, 64, TRUE);
+		if (*fence == val) {
+			return 0;
+		}
+	}
+	return -1;
+}
+
+/* Everything the CP needs after a reset, same order as steps 10-11. */
+static int
+cp_bringup(void)
+{
+	ring_wptr = 0;
+	wr(gpu, A5_CP_PFP_INSTR_BASE, (uint32_t)ucode_pfp_pa);
+	wr(gpu, A5_CP_PFP_INSTR_BASE + 4, (uint32_t)(ucode_pfp_pa >> 32));
+	wr(gpu, A5_CP_ME_INSTR_BASE, (uint32_t)ucode_pm4_pa);
+	wr(gpu, A5_CP_ME_INSTR_BASE + 4, (uint32_t)(ucode_pm4_pa >> 32));
+	wr(gpu, A5_CP_RB_BASE, (uint32_t)ring_pa);
+	wr(gpu, A5_CP_RB_BASE + 4, (uint32_t)(ring_pa >> 32));
+	wr(gpu, A5_CP_RB_RPTR_ADDR, (uint32_t)rptr_pa);
+	wr(gpu, A5_CP_RB_RPTR_ADDR + 4, (uint32_t)(rptr_pa >> 32));
+	wr(gpu, A5_CP_RB_CNTL, 12u | (2u << 8) | RB_NO_UPDATE);
+	wr(gpu, A5_SECVID_TSB_CNTL, 0);
+	wr(gpu, A5_SECVID_TSB_BASE_LO, 0);
+	wr(gpu, A5_SECVID_TSB_BASE_LO + 4, 0);
+	wr(gpu, A5_SECVID_TSB_SIZE, 0);
+	wr(gpu, A5_CP_ADDR_MODE_CNTL, 1);
+	wr(gpu, A5_SECVID_TSB_ADDR_MODE, 1);
+	wr(gpu, A5_CP_MEQ_THRESHOLDS, 0x40);
+	wr(gpu, A5_CP_MERCIU_SIZE, 0x400);
+	wr(gpu, A5_CP_ROQ_THRESH_2, 0x80000060);
+	wr(gpu, A5_CP_ROQ_THRESH_1, 0x40201b16);
+	wr(gpu, A5_CP_CHICKEN_DBG, 0x02000000);
+	wr(gpu, A5_RBBM_INT_0_MASK, 0);
+	wr(gpu, A5_CP_PFP_ME_CNTL, 0);
+	whyred_wait(50);
+	ring_pkt7(CP_ME_INIT, 8);
+	ring_put(0x0000002f);
+	ring_put(0x00000003);
+	ring_put(0x20000000);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	if (ring_submit("re-ME_INIT") != 0) {
+		return -1;
+	}
+	ring_pkt7(CP_SET_SECURE_MODE, 1);
+	ring_put(0);
+	return ring_submit("re-SET_SECURE_MODE");
+}
+
+static void
+step12_fence_reset(void)
+{
+	unsigned ok = 0;
+	uint32_t trust;
+
+	if (ring_va == 0 || ring_pa == 0) {
+		printf("WHYRED GPU: step 12 needs steps 10 and 11\n");
+		return;
+	}
+	whyred_announce("step 12: 16 fences with different values");
+	for (unsigned i = 0; i < 16; i++) {
+		if (fence_test(0xcafe0100u + i, 100) == 0) {
+			ok++;
+		} else {
+			printf("WHYRED GPU: fence %u did not land\n", i);
+		}
+	}
+	printf("WHYRED GPU: fence burst: %u of 16 landed, RPTR %u WPTR %u\n", ok,
+	    rd(gpu, A5_CP_RB_RPTR), rd(gpu, A5_CP_RB_WPTR));
+	if (ok != 16) {
+		return;
+	}
+
+	whyred_announce("step 12: deliberate hang (short CP_NOP swallows the next packet)");
+	ring_pkt7(CP_NOP, 64);
+	ring_put(0);
+	ring_put(0);
+	if (fence_test(0xdead0001u, 500) == 0) {
+		printf("WHYRED GPU: the hang did NOT hang the CP, stopping\n");
+		return;
+	}
+	printf("WHYRED GPU: CP is stuck as intended: RPTR %u WPTR %u RBBM_STATUS %08x "
+	    "INT_0 %08x\n", rd(gpu, A5_CP_RB_RPTR), rd(gpu, A5_CP_RB_WPTR),
+	    rd(gpu, A5_RBBM_STATUS), rd(gpu, A5_RBBM_INT_0_STATUS));
+
+	whyred_announce("step 12: RBBM software reset");
+	wr(gpu, A5_RBBM_SW_RESET_CMD, 1);
+	(void)rd(gpu, A5_RBBM_SW_RESET_CMD);
+	whyred_wait(5);
+	wr(gpu, A5_RBBM_SW_RESET_CMD, 0);
+	whyred_wait(5);
+	trust = rd(gpu, A5_RBBM_SECVID_TRUST);
+	printf("WHYRED GPU: after reset: RBBM_STATUS %08x SECVID_TRUST_CNTL %08x "
+	    "RPTR %u WPTR %u CP_PFP_ME_CNTL %08x\n", rd(gpu, A5_RBBM_STATUS),
+	    trust, rd(gpu, A5_CP_RB_RPTR), rd(gpu, A5_CP_RB_WPTR),
+	    rd(gpu, A5_CP_PFP_ME_CNTL));
+
+	whyred_announce("step 12: bring the CP up again");
+	if (cp_bringup() != 0) {
+		printf("WHYRED GPU: recovery failed in the bring-up\n");
+		return;
+	}
+	if (fence_test(0xcafe0200u, 200) == 0) {
+		printf("WHYRED GPU: RECOVERED: a fence landed after the reset, "
+		    "SECVID_TRUST_CNTL %08x\n", rd(gpu, A5_RBBM_SECVID_TRUST));
+	} else {
+		printf("WHYRED GPU: recovery failed: the fence did not land\n");
+	}
+}
+
+/*
+ * Step 13: the first compute dispatch. A hand-assembled shader (ir3; the A5xx
+ * encodings are checked against the vectors of Mesa's ir3 disassembler test:
+ * cat1 mov immediate, cat6 stg, cat0 nop and end) stores 0xc0de0001 to a
+ * global address through the SP. Register order follows Gallium fd5
+ * (cs_program_emit, fd5_launch_grid) as a behaviour reference, no code taken.
+ * The shader is preloaded into the SP with CP_LOAD_STATE4 (INSTRLEN 1 = 16
+ * instructions). If the word does not land the GPU is reset and the CP is
+ * brought up again.
+ */
+#define R_SP_SP_CNTL            0xe580u
+#define R_HLSQ_CONTROL_0        0xe784u
+#define R_SP_CS_CTRL_REG0       0xe5f0u
+#define R_HLSQ_CS_CONFIG        0xe790u
+#define R_HLSQ_CS_CNTL          0xe796u
+#define R_SP_CS_CONFIG          0xe589u
+#define R_HLSQ_CS_CONSTLEN      0xe7dcu
+#define R_SP_CS_OBJ_START       0xe5f3u
+#define R_HLSQ_UPDATE_CNTL      0xe78au
+#define R_HLSQ_CS_CNTL_0        0xe7b7u
+#define R_HLSQ_CS_NDRANGE_0     0xe7b0u
+#define R_HLSQ_CS_KERNEL_GROUP  0xe7b9u
+#define R_TPL1_CS_TEX_COUNT     0xe751u
+#define R_SP_MODE_CNTL          0x0ec2u
+#define R_SP_DBG_ECO_CNTL       0x0ec0u
+#define R_TPL1_MODE_CNTL        0x0f02u
+#define R_HLSQ_MODE_CNTL        0x0e06u
+#define R_HLSQ_TIMEOUT_0        0x0e00u
+#define R_UCHE_INVALIDATE_MIN   0x0e91u
+#define CP_WAIT_FOR_IDLE        38u
+#define CP_EXEC_CS              0x33u
+#define CP_EVENT_WRITE          0x46u
+#define CP_LOAD_STATE4          0x30u
+#define SHADER_OUT_VALUE        0xc0de0001u
+
+static uint32_t
+pm4_pkt4(uint32_t reg, uint32_t cnt)
+{
+	return 0x40000000u | cnt | (pm4_parity(cnt) << 7) |
+	    ((reg & 0x3ffffu) << 8) | (pm4_parity(reg & 0x3ffffu) << 27);
+}
+
+static void
+ring_pkt4(uint32_t reg, uint32_t cnt)
+{
+	ring_put(pm4_pkt4(reg, cnt));
+}
+
+static void
+ring_reg(uint32_t reg, uint32_t v)
+{
+	ring_pkt4(reg, 1);
+	ring_put(v);
+}
+
+/* mov.u32u32 rN.c, imm : cat1, DST_TYPE = SRC_TYPE = u32, immediate source */
+static void
+shader_mov(uint32_t *p, uint32_t reg, uint32_t imm)
+{
+	p[0] = imm;
+	p[1] = 0x204cc000u | reg;
+}
+
+static void
+step13_compute(int mode)
+{
+	static const uint32_t addr_mode_regs[] = {
+		0x0bc1u, 0x0c81u, 0x0cc5u, 0x0d01u, 0x0e05u, 0x0e41u, 0x0e61u,
+		0x0e80u, 0x0ec1u, 0x0f01u,
+	};
+	vm_offset_t sh_va = 0;
+	vm_offset_t cb = smmu_va + 0x8000u + SMMU_CB * 0x1000u;	/* GPU context bank 4 */
+	uint64_t sh_pa = 0, out_pa = mode >= 4 ? rptr_pa + 0x600 : mode ? rptr_pa + 0x240 : fence_pa + 0x40;
+	/* mode 2 loads the word the step 13 shader stored (written by the GPU), not a CPU written one */
+	uint64_t in_pa = mode >= 4 ? rptr_pa + 0x400 : mode == 3 ? fence_pa + 0x40 : rptr_pa + 0x200;
+	uint32_t nthreads = mode >= 4 ? 64 : 1;
+	uint32_t want = mode == 3 ? SHADER_OUT_VALUE : mode == 2 ? 0x00abcdefu : mode ? 0x11bcdf00u : SHADER_OUT_VALUE;
+	volatile uint32_t *out = (volatile uint32_t *)(rptr_va + (mode >= 4 ? 0x600 : mode ? 0x240 : 0x140));
+	volatile uint32_t *in = (volatile uint32_t *)(rptr_va + (mode >= 4 ? 0x400 : mode == 3 ? 0x140 : 0x200));
+	uint32_t *sh;
+
+	if (ring_va == 0 || ring_pa == 0) {
+		printf("WHYRED GPU: step 13 needs steps 10-12\n");
+		return;
+	}
+	if (whyred_alloc(0x1000, PAGE_MASK, &sh_va, &sh_pa)) {
+		printf("WHYRED GPU: no page for the shader\n");
+		return;
+	}
+	sh = (uint32_t *)sh_va;
+	shader_mov(&sh[0], 0, (uint32_t)out_pa);		/* r0.x = address low */
+	shader_mov(&sh[2], 1, (uint32_t)(out_pa >> 32));	/* r0.y = address high */
+	shader_mov(&sh[4], 4, SHADER_OUT_VALUE);		/* r1.x = value */
+	sh[6] = 0;
+	sh[7] = 0x00000500u;					/* (rpt5)nop */
+	sh[8] = 0;
+	sh[9] = 0x00000500u;					/* (rpt5)nop */
+	sh[10] = 0x01800000u | (4u << 1);			/* stg.u32 g[r0.x], r1.x, 1 */
+	sh[11] = 0xc0c60100u;
+	sh[12] = 0;
+	sh[13] = 0x00000500u;					/* (rpt5)nop */
+	sh[14] = 0;
+	sh[15] = 0x03000000u;					/* end */
+	if (mode) {
+		/* out = in + 0x11111111: ldg, add.s, stg; encodings from Mesa's ir3 disasm vectors */
+		memset(sh, 0, 0x100);
+		shader_mov(&sh[0], 0, (uint32_t)in_pa);			/* r0.x */
+		shader_mov(&sh[2], 1, (uint32_t)(in_pa >> 32));		/* r0.y */
+		shader_mov(&sh[4], 8, (uint32_t)out_pa);		/* r2.x */
+		shader_mov(&sh[6], 9, (uint32_t)(out_pa >> 32));	/* r2.y */
+		shader_mov(&sh[8], 12, 0x11111111u);			/* r3.x */
+		sh[11] = 0x00000500u;					/* (rpt5)nop */
+		sh[12] = 0x01800001u;					/* ldg.u32 r1.x, g[r0.x], 1 */
+		sh[13] = 0xc0060004u;
+		sh[15] = 0x00000500u;
+		sh[16] = 0x000c0004u;					/* (sy)add.s r1.x, r1.x, r3.x */
+		sh[17] = 0x52380804u;
+		sh[19] = 0x00000500u;
+		sh[20] = 0x01800008u;					/* stg.u32 g[r2.x], r1.x, 1 */
+		sh[21] = 0xc0c61100u;
+		sh[23] = 0x00000500u;
+		sh[25] = 0x03000000u;					/* end */
+		if (mode >= 2) {
+			/* copy only: drop the add, the store waits for the load with (sy) */
+			sh[16] = 0;
+			sh[17] = 0x00000500u;
+			sh[21] = 0xd0c61100u;
+		}
+		if (mode != 3) {
+			*in = 0x00abcdefu;
+			flush_dcache64((addr64_t)(in_pa & ~63ull), 64, TRUE);
+		}
+	}
+	if (mode >= 4) {
+		/* 64 threads, local id in r4.x..z (HLSQ_CS_CNTL_0 LOCALIDREGID = r4.x):
+		 * 4: out[tid] = 0x600d0000   5: out[tid] = in[tid] + 0x11111111 */
+		memset(sh, 0, 0x100);
+		shader_mov(&sh[0], 0, (uint32_t)in_pa);			/* r0.x */
+		shader_mov(&sh[2], 1, (uint32_t)(in_pa >> 32));		/* r0.y */
+		shader_mov(&sh[4], 8, (uint32_t)out_pa);		/* r2.x */
+		shader_mov(&sh[6], 9, (uint32_t)(out_pa >> 32));	/* r2.y */
+		if (mode == 4) {
+			shader_mov(&sh[8], 4, 0x600d0000u);		/* r1.x */
+			sh[11] = 0x00000500u;
+			sh[12] = 0x01800008u;				/* stg.a.u32 g[r2.x+(r4.x<<2)], r1.x, 1 */
+			sh[13] = 0xc0d61110u;
+			sh[15] = 0x00000500u;
+			sh[17] = 0x03000000u;				/* end */
+		} else {
+			shader_mov(&sh[8], 12, 0x11111111u);		/* r3.x */
+			sh[11] = 0x00000500u;
+			sh[12] = 0x01c00021u;				/* ldg.a.u32 r1.x, g[r0.x+(r4.x<<2)], 1 */
+			sh[13] = 0xc0060004u;
+			sh[15] = 0x00000500u;
+			sh[16] = 0x000c0004u;				/* (sy)add.s r1.x, r1.x, r3.x */
+			sh[17] = 0x52380804u;
+			sh[19] = 0x00000500u;
+			sh[20] = 0x01800008u;				/* stg.a.u32 g[r2.x+(r4.x<<2)], r1.x, 1 */
+			sh[21] = 0xc0d61110u;
+			sh[23] = 0x00000500u;
+			sh[25] = 0x03000000u;				/* end */
+			for (uint32_t i = 0; i < nthreads; i++) {
+				in[i] = (i * 0x01010101u) ^ 0x00abcdefu;
+			}
+			flush_dcache64((addr64_t)(in_pa & ~63ull), nthreads * 4, TRUE);
+		}
+	}
+	flush_dcache64((addr64_t)sh_pa, 0x1000, TRUE);
+	printf("WHYRED GPU: shader pa %llx, output pa %llx\n",
+	    (unsigned long long)sh_pa, (unsigned long long)out_pa);
+	for (int i = 0; i < 32; i += 2) {
+		printf("WHYRED GPU: shader dwords %08x %08x\n", sh[i], sh[i + 1]);
+	}
+
+	if (mode) {
+		/* the SP/UCHE loads may come from other stream ids than the CP: match every id to CB4 */
+		printf("WHYRED GPU: SMMU before: GFSR %08x CB4 FSR %08x SMR0 %08x\n", rd(smmu_va, 0x48),
+		    rd(cb, CB_FSR), rd(smmu_va, 0x800));
+		wr(smmu_va, 0x800, (1u << 31) | (0x7fffu << 16));
+		printf("WHYRED GPU: SMR0 now %08x\n", rd(smmu_va, 0x800));
+	}
+	whyred_announce("step 13: WRITE the 64-bit address-mode and UCHE registers");
+	for (unsigned i = 0; i < sizeof(addr_mode_regs) / sizeof(addr_mode_regs[0]); i++) {
+		wr(gpu, addr_mode_regs[i] * 4, 1);
+	}
+	wr(gpu, 0x0e96u * 4, 2);				/* UCHE_CACHE_WAYS */
+	wr(gpu, 0x0e89u * 4, 0xffff0000u);			/* UCHE_TRAP_BASE */
+	wr(gpu, 0x0e89u * 4 + 4, 0x0001ffffu);
+	wr(gpu, 0x0e87u * 4, 0xffff0000u);			/* UCHE_WRITE_THRU_BASE */
+	wr(gpu, 0x0e87u * 4 + 4, 0x0001ffffu);
+	wr(gpu, 0x0e8bu * 4, 0x00100000u);			/* UCHE_GMEM_RANGE_MIN */
+	wr(gpu, 0x0e8bu * 4 + 4, 0);
+	wr(gpu, 0x0e8du * 4, 0x00100000u + 0x80000u - 1);	/* UCHE_GMEM_RANGE_MAX */
+	wr(gpu, 0x0e8du * 4 + 4, 0);
+	wr(gpu, 0x0e81u * 4, 1u << 29);				/* UCHE_MODE_CNTL */
+
+	for (uint32_t i = 0; i < nthreads; i++) {
+		out[i] = mode ? 0xdeadbeefu : 0;		/* a store of 0 must not look like no store */
+	}
+	flush_dcache64((addr64_t)(out_pa & ~63ull), nthreads * 4, TRUE);
+
+	whyred_announce("step 13: submit the compute dispatch");
+	/* cache flush, like fd5_cache_flush */
+	ring_pkt4(R_UCHE_INVALIDATE_MIN, 5);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0x12);
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	/* the part of fd5_emit_restore a compute dispatch relies on */
+	ring_reg(R_HLSQ_UPDATE_CNTL, 0xfffff);
+	ring_reg(R_SP_MODE_CNTL, 0x1e);
+	ring_reg(R_SP_DBG_ECO_CNTL, 0x40000800u);
+	ring_reg(R_TPL1_MODE_CNTL, 0x544);
+	ring_pkt4(R_HLSQ_TIMEOUT_0, 2);
+	ring_put(0x80);
+	ring_put(0);
+	ring_reg(R_HLSQ_MODE_CNTL, 1);
+	/* cs_program_emit with instrlen = 1 */
+	ring_reg(R_SP_SP_CNTL, 0);
+	ring_reg(R_HLSQ_CONTROL_0, 0x880);			/* TWO_QUADS | 0x880 */
+	ring_reg(R_SP_CS_CTRL_REG0, ((mode >= 4 ? 6u : mode ? 4u : 2u) << 10) | (1u << 2) | 0x2);	/* r0..r3 = 4 full regs for the buffer shaders, BUFFER */
+	ring_reg(R_HLSQ_CS_CONFIG, 1);
+	ring_reg(R_HLSQ_CS_CNTL, 1u << 1);			/* INSTRLEN 1 */
+	ring_reg(R_SP_CS_CONFIG, 1);
+	ring_pkt4(R_HLSQ_CS_CONSTLEN, 2);
+	ring_put(0);
+	ring_put(1);						/* CONSTLEN 0, INSTRLEN 1 */
+	ring_pkt4(R_SP_CS_OBJ_START, 6);
+	ring_put((uint32_t)sh_pa);
+	ring_put((uint32_t)(sh_pa >> 32));
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_reg(R_HLSQ_UPDATE_CNTL, 0x1f00000u);
+	ring_pkt4(R_HLSQ_CS_CNTL_0, 2);
+	ring_put(0xfcu | (0xfcu << 8) | (0xfcu << 16) | ((mode >= 4 ? 16u : 0xfcu) << 24));
+	ring_put(1);
+	/* load the shader into the SP: CP_LOAD_STATE4, indirect, CS shader block */
+	ring_pkt7(CP_LOAD_STATE4, 3);
+	ring_put((2u << 16) | (0xdu << 18) | (1u << 22));
+	ring_put((uint32_t)sh_pa);				/* STATE_TYPE ST4_SHADER = 0 */
+	ring_put((uint32_t)(sh_pa >> 32));
+	ring_reg(R_TPL1_CS_TEX_COUNT, 0);
+	ring_pkt4(R_HLSQ_CS_NDRANGE_0, 7);
+	ring_put(3u | ((nthreads - 1) << 2));			/* KERNELDIM 3, local size nthreads x1x1 */
+	ring_put(nthreads);					/* global size x */
+	ring_put(0);
+	ring_put(1);
+	ring_put(0);
+	ring_put(1);
+	ring_put(0);
+	ring_pkt4(R_HLSQ_CS_KERNEL_GROUP, 3);
+	ring_put(1);
+	ring_put(1);
+	ring_put(1);
+	ring_pkt7(CP_EXEC_CS, 4);
+	ring_put(0);
+	ring_put(1);
+	ring_put(1);
+	ring_put(1);
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	/* the SP store may sit in the write-back UCHE: flush it out, like fd5 does after a dispatch */
+	ring_pkt4(R_UCHE_INVALIDATE_MIN, 5);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0x12);
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	ring_pkt7(CP_EVENT_WRITE, 4);
+	ring_put(0x4u | (1u << 30));				/* CACHE_FLUSH_TS */
+	ring_put((uint32_t)(fence_pa + 0x80));
+	ring_put((uint32_t)((fence_pa + 0x80) >> 32));
+	ring_put(0x1234u);
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	if (ring_submit("compute dispatch") != 0) {
+		printf("WHYRED GPU: the CP did not consume the dispatch, resetting\n");
+		goto recover;
+	}
+	for (int i = 0; i < 100; i++) {
+		whyred_wait(5);
+		flush_dcache64((addr64_t)(out_pa & ~63ull), nthreads * 4, TRUE);
+		if (mode >= 4) {
+			uint32_t good = 0, written = 0, first_bad = 0xffffffffu;
+			for (uint32_t t = 0; t < nthreads; t++) {
+				uint32_t w = mode == 4 ? 0x600d0000u : in[t] + 0x11111111u;
+				written += out[t] != 0xdeadbeefu;
+				if (out[t] == w) {
+					good++;
+				} else if (first_bad == 0xffffffffu) {
+					first_bad = t;
+				}
+			}
+			if (good == nthreads || (i == 99 && written)) {
+				printf("WHYRED GPU: %u threads: %u of %u outputs correct, %u written%s after %d ms, RBBM_STATUS %08x\n",
+				    nthreads, good, nthreads, written, good == nthreads ? " (ALL CORRECT)" : "", i * 5,
+				    rd(gpu, A5_RBBM_STATUS));
+				for (uint32_t t = 0; t < nthreads && good != nthreads && t < 8; t++) {
+					printf("WHYRED GPU: out[%u] %08x in[%u] %08x\n", t, out[t], t, in[t]);
+				}
+				return;
+			}
+		} else if (*out == want) {
+			printf("WHYRED GPU: SHADER WROTE IT: %08x after %d ms, RBBM_STATUS %08x\n",
+			    *out, i * 5, rd(gpu, A5_RBBM_STATUS));
+			return;
+		}
+	}
+	printf("WHYRED GPU: the shader output did not land (%08x): RBBM_STATUS %08x "
+	    "INT_0 %08x AHB_ERR %08x RPTR %u WPTR %u\n", *out, rd(gpu, A5_RBBM_STATUS),
+	    rd(gpu, A5_RBBM_INT_0_STATUS), rd(gpu, A5_RBBM_AHB_ERR_STATUS),
+	    rd(gpu, A5_CP_RB_RPTR), rd(gpu, A5_CP_RB_WPTR));
+	flush_dcache64((addr64_t)((fence_pa + 0x80) & ~63ull), 64, TRUE);
+	printf("WHYRED GPU: cache flush event word %08x (expect 00001234 if the event ran)\n",
+	    *(volatile uint32_t *)(rptr_va + 0x180));
+	flush_dcache64((addr64_t)(in_pa & ~63ull), 64, TRUE);
+	printf("WHYRED GPU: input buffer now %08x\n", *in);
+	printf("WHYRED GPU: SMMU after: GFSR %08x CB4 FSR %08x\n", rd(smmu_va, 0x48), rd(cb, CB_FSR));
+recover:
+	whyred_announce("step 13: RBBM software reset after the failed dispatch");
+	wr(gpu, A5_RBBM_SW_RESET_CMD, 1);
+	(void)rd(gpu, A5_RBBM_SW_RESET_CMD);
+	whyred_wait(5);
+	wr(gpu, A5_RBBM_SW_RESET_CMD, 0);
+	whyred_wait(5);
+	if (cp_bringup() == 0 && fence_test(0xcafe0300u, 200) == 0) {
+		printf("WHYRED GPU: recovered after the failed dispatch\n");
+	} else {
+		printf("WHYRED GPU: no recovery after the failed dispatch\n");
+	}
+}
+
+/*
+ * Step 18 (M4.0): a 2D blit through the A5xx 2D core (RB_2D_*, CP_BLIT), the
+ * path Mesa's fd5 blitter takes for buffer copies: a 64 byte R8 linear
+ * "image" of one row is copied src -> dst, then compared by the CPU. Register
+ * values come from a5xx.xml / adreno_pm4.xml / adreno_common.xml; the order is
+ * the one fd5's emit_setup and emit_blit_buffer use (behaviour reference only).
+ */
+#define CP_SET_RENDER_MODE      0x6cu
+#define CP_BLIT                 0x2cu
+
+static void
+step18_blit2d(void)
+{
+	uint64_t src_pa = rptr_pa + 0x800, dst_pa = rptr_pa + 0x900;
+	volatile uint8_t *src = (volatile uint8_t *)(rptr_va + 0x800);
+	volatile uint8_t *dst = (volatile uint8_t *)(rptr_va + 0x900);
+	uint32_t good = 0;
+
+	if (ring_va == 0 || ring_pa == 0) {
+		printf("WHYRED GPU: step 18 needs steps 10-12\n");
+		return;
+	}
+	for (uint32_t i = 0; i < 64; i++) {
+		src[i] = (uint8_t)(i * 3 + 1);
+		dst[i] = 0xee;
+	}
+	flush_dcache64((addr64_t)src_pa, 64, TRUE);
+	flush_dcache64((addr64_t)dst_pa, 64, TRUE);
+
+	whyred_announce("step 18: submit a 2D blit (64 byte copy)");
+	/* emit_setup */
+	ring_reg(0xe141u, 0x8);				/* RB_RENDER_CNTL */
+	ring_reg(0x2100u, 0x86000000u);			/* RB_2D_BLIT_CNTL: ROP_COPY, UNORM8, bit 31 */
+	ring_reg(0x2180u, 0x86000000u);			/* GRAS_2D_BLIT_CNTL */
+	ring_reg(0x2184u, 0x9);				/* UNKNOWN_2184 */
+	ring_reg(0xe140u, 1u << 17);			/* RB_CNTL: BYPASS */
+	ring_reg(0x0cc6u, 1u << 1);			/* RB_MODE_CNTL: highest bank bit 14 - 13 */
+	ring_reg(R_SP_MODE_CNTL, 0xc);			/* constant demotion | 8 */
+	ring_reg(R_TPL1_MODE_CNTL, 0x244u | (1u << 7));
+	ring_reg(R_HLSQ_MODE_CNTL, 0x2);
+	ring_reg(0xe000u, 0x181);			/* GRAS_CL_CNTL */
+	/* emit_blit_buffer */
+	ring_pkt7(CP_SET_RENDER_MODE, 1);
+	ring_put(5);					/* BLIT2D */
+	ring_pkt4(0x2107u, 9);				/* RB_2D_SRC_INFO .. */
+	ring_put(0x3);					/* R8_UNORM, linear, WZYX */
+	ring_put((uint32_t)src_pa);
+	ring_put((uint32_t)(src_pa >> 32));
+	ring_put(1u | (2u << 16));			/* pitch 64 >> 6, array pitch 128 >> 6 */
+	for (int i = 0; i < 5; i++) {
+		ring_put(0);
+	}
+	ring_reg(0x2181u, 0x3);				/* GRAS_2D_SRC_INFO */
+	ring_pkt4(0x2110u, 9);				/* RB_2D_DST_INFO .. */
+	ring_put(0x3);
+	ring_put((uint32_t)dst_pa);
+	ring_put((uint32_t)(dst_pa >> 32));
+	ring_put(1u | (2u << 16));
+	for (int i = 0; i < 5; i++) {
+		ring_put(0);
+	}
+	ring_reg(0x2182u, 0x3);				/* GRAS_2D_DST_INFO */
+	ring_pkt4(0x2000u, 5);				/* TPL1_A2D_SRC_TEXTURE_INFO .. */
+	ring_put(0x3);
+	ring_put(64u | (1u << 15));			/* width 64, height 1 */
+	ring_put((uint32_t)src_pa);
+	ring_put((uint32_t)(src_pa >> 32));
+	ring_put(1u << 9);				/* pitch 64 >> 6, at bit 9 */
+	ring_reg(0x2040u, 0x3u << 3);			/* SP_A2D_OUTPUT_INFO: float, R8_UNORM */
+	ring_pkt7(CP_BLIT, 5);
+	ring_put(3);					/* BLIT_OP_SCALE */
+	ring_put(0);					/* SRC_X1, SRC_Y1 */
+	ring_put(63);					/* SRC_X2, SRC_Y2 */
+	ring_put(0);					/* DST_X1, DST_Y1 */
+	ring_put(63);					/* DST_X2, DST_Y2 */
+	ring_pkt7(CP_SET_RENDER_MODE, 1);
+	ring_put(8);					/* END2D */
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	/* the 2D core writes through the CCU colour cache: flush it to memory */
+	ring_pkt7(CP_EVENT_WRITE, 4);
+	ring_put(0x1du | (1u << 30));			/* PC_CCU_FLUSH_COLOR_TS */
+	ring_put((uint32_t)(fence_pa + 0x100));
+	ring_put((uint32_t)((fence_pa + 0x100) >> 32));
+	ring_put(0x5678u);
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	ring_pkt4(R_UCHE_INVALIDATE_MIN, 5);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0x12);
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	ring_pkt7(CP_EVENT_WRITE, 4);
+	ring_put(0x4u | (1u << 30));			/* CACHE_FLUSH_TS */
+	ring_put((uint32_t)(fence_pa + 0xc0));
+	ring_put((uint32_t)((fence_pa + 0xc0) >> 32));
+	ring_put(0x1234u);
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	if (ring_submit("2D blit") != 0) {
+		printf("WHYRED GPU: the CP did not consume the 2D blit\n");
+		return;
+	}
+	for (int i = 0; i < 100; i++) {
+		whyred_wait(5);
+		flush_dcache64((addr64_t)dst_pa, 64, TRUE);
+		good = 0;
+		for (uint32_t t = 0; t < 64; t++) {
+			good += dst[t] == (uint8_t)(t * 3 + 1);
+		}
+		if (good == 64 || i == 99) {
+			break;
+		}
+	}
+	printf("WHYRED GPU: 2D blit: %u of 64 bytes copied%s, RBBM_STATUS %08x\n", good,
+	    good == 64 ? " (ALL CORRECT)" : "", rd(gpu, A5_RBBM_STATUS));
+	if (good != 64) {
+		printf("WHYRED GPU: dst %02x %02x %02x %02x %02x %02x %02x %02x (src starts 01 04 07 0a ..)\n",
+		    dst[0], dst[1], dst[2], dst[3], dst[4], dst[5], dst[6], dst[7]);
+	}
+}
+
+/*
+ * Step 19 (M4.1): a 2D copy of a rectangle between two RGBA8 linear images
+ * (32x16, pitch 128): the 16x8 box at (4,2) goes to (8,4). The CPU checks every
+ * pixel of the box and that the rest of the destination was left alone.
+ */
+#define IMG_W 32u
+#define IMG_H 16u
+#define IMG_PITCH (IMG_W * 4u)
+#define IMG_BYTES (IMG_PITCH * IMG_H)
+
+static uint32_t
+img_pixel(uint32_t x, uint32_t y)
+{
+	return 0xff000000u | (y << 16) | (x << 8) | 0x5au;
+}
+
+static void
+step19_blit_rgba(void)
+{
+	vm_offset_t va = 0;
+	uint64_t pa = 0, src_pa, dst_pa;
+	volatile uint32_t *src, *dst;
+	uint32_t inside = 0, outside = 0, wrong_first = 0xffffffffu;
+	const uint32_t sx = 4, sy = 2, bw = 16, bh = 8, dx = 8, dy = 4;
+
+	if (ring_va == 0 || ring_pa == 0) {
+		printf("WHYRED GPU: step 19 needs steps 10-12\n");
+		return;
+	}
+	if (whyred_alloc(0x2000, PAGE_MASK, &va, &pa)) {
+		printf("WHYRED GPU: no pages for the images\n");
+		return;
+	}
+	src_pa = pa;
+	dst_pa = pa + 0x1000;
+	src = (volatile uint32_t *)va;
+	dst = (volatile uint32_t *)(va + 0x1000);
+	for (uint32_t y = 0; y < IMG_H; y++) {
+		for (uint32_t x = 0; x < IMG_W; x++) {
+			src[y * IMG_W + x] = img_pixel(x, y);
+			dst[y * IMG_W + x] = 0xdeadbeefu;
+		}
+	}
+	flush_dcache64((addr64_t)src_pa, IMG_BYTES, TRUE);
+	flush_dcache64((addr64_t)dst_pa, IMG_BYTES, TRUE);
+
+	whyred_announce("step 19: submit a 2D blit (RGBA8 rectangle copy)");
+	ring_reg(0xe141u, 0x8);
+	ring_reg(0x2100u, 0x86000000u);
+	ring_reg(0x2180u, 0x86000000u);
+	ring_reg(0x2184u, 0x9);
+	ring_reg(0xe140u, 1u << 17);
+	ring_reg(0x0cc6u, 1u << 1);
+	ring_reg(R_SP_MODE_CNTL, 0xc);
+	ring_reg(R_TPL1_MODE_CNTL, 0x244u | (1u << 7));
+	ring_reg(R_HLSQ_MODE_CNTL, 0x2);
+	ring_reg(0xe000u, 0x181);
+	ring_pkt7(CP_SET_RENDER_MODE, 1);
+	ring_put(5);
+	ring_pkt4(0x2107u, 9);
+	ring_put(0x30);					/* RB5_R8G8B8A8_UNORM, linear, WZYX */
+	ring_put((uint32_t)src_pa);
+	ring_put((uint32_t)(src_pa >> 32));
+	ring_put((IMG_PITCH >> 6) | ((IMG_BYTES >> 6) << 16));
+	for (int i = 0; i < 5; i++) {
+		ring_put(0);
+	}
+	ring_reg(0x2181u, 0x30);
+	ring_pkt4(0x2110u, 9);
+	ring_put(0x30);
+	ring_put((uint32_t)dst_pa);
+	ring_put((uint32_t)(dst_pa >> 32));
+	ring_put((IMG_PITCH >> 6) | ((IMG_BYTES >> 6) << 16));
+	for (int i = 0; i < 5; i++) {
+		ring_put(0);
+	}
+	ring_reg(0x2182u, 0x30);
+	ring_pkt4(0x2000u, 5);
+	ring_put(0x30);
+	ring_put(IMG_W | (IMG_H << 15));
+	ring_put((uint32_t)src_pa);
+	ring_put((uint32_t)(src_pa >> 32));
+	ring_put((IMG_PITCH >> 6) << 9);
+	ring_reg(0x2040u, 0x30u << 3);
+	ring_pkt7(CP_BLIT, 5);
+	ring_put(3);
+	ring_put(sx | (sy << 16));
+	ring_put((sx + bw - 1) | ((sy + bh - 1) << 16));
+	ring_put(dx | (dy << 16));
+	ring_put((dx + bw - 1) | ((dy + bh - 1) << 16));
+	ring_pkt7(CP_SET_RENDER_MODE, 1);
+	ring_put(8);
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	ring_pkt7(CP_EVENT_WRITE, 4);
+	ring_put(0x1du | (1u << 30));
+	ring_put((uint32_t)(fence_pa + 0x100));
+	ring_put((uint32_t)((fence_pa + 0x100) >> 32));
+	ring_put(0x5678u);
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	ring_pkt4(R_UCHE_INVALIDATE_MIN, 5);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0x12);
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	ring_pkt7(CP_EVENT_WRITE, 4);
+	ring_put(0x4u | (1u << 30));
+	ring_put((uint32_t)(fence_pa + 0xc0));
+	ring_put((uint32_t)((fence_pa + 0xc0) >> 32));
+	ring_put(0x1234u);
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	if (ring_submit("RGBA blit") != 0) {
+		printf("WHYRED GPU: the CP did not consume the RGBA blit\n");
+		return;
+	}
+	whyred_wait(50);
+	flush_dcache64((addr64_t)dst_pa, IMG_BYTES, TRUE);
+	for (uint32_t y = 0; y < IMG_H; y++) {
+		for (uint32_t x = 0; x < IMG_W; x++) {
+			uint32_t got = dst[y * IMG_W + x];
+			bool in_box = x >= dx && x < dx + bw && y >= dy && y < dy + bh;
+			if (in_box) {
+				if (got == img_pixel(x - dx + sx, y - dy + sy)) {
+					inside++;
+				} else if (wrong_first == 0xffffffffu) {
+					wrong_first = y * IMG_W + x;
+				}
+			} else if (got == 0xdeadbeefu) {
+				outside++;
+			}
+		}
+	}
+	printf("WHYRED GPU: RGBA blit: %u of %u box pixels right, %u of %u outside pixels untouched%s\n",
+	    inside, bw * bh, outside, IMG_W * IMG_H - bw * bh,
+	    (inside == bw * bh && outside == IMG_W * IMG_H - bw * bh) ? " (ALL CORRECT)" : "");
+	if (wrong_first != 0xffffffffu) {
+		printf("WHYRED GPU: first wrong pixel %u: got %08x want %08x\n", wrong_first,
+		    dst[wrong_first],
+		    img_pixel((wrong_first % IMG_W) - dx + sx, (wrong_first / IMG_W) - dy + sy));
+	}
+}
+
+/*
+ * Step 20 (M4.2): a solid colour fill of a 16x8 box in an RGBA8 image with the
+ * 2D core. Mesa's fd5 does not use a 2D fill, so the register recipe is tried in
+ * variants (a5xx.xml: RB_2D_SRC_SOLID_DW0..3, "0x86000000 for copy, 0x00000000 for
+ * fill?"): 0 = copy control word, op FILL, integer components; 1 = control word 0;
+ * 2 = copy control word, float components. Each variant gets a fresh destination.
+ */
+static void
+step20_blit_fill(void)
+{
+	static const uint32_t cntl[3] = { 0x86000000u, 0x00000000u, 0x86000000u };
+	static const uint32_t colour[3][4] = {
+		{ 0x33, 0x66, 0xcc, 0xff },
+		{ 0x33, 0x66, 0xcc, 0xff },
+		{ 0x3e4ccccdu, 0x3ecccccdu, 0x3f4ccccdu, 0x3f800000u },	/* 0.2 0.4 0.8 1.0 */
+	};
+	const uint32_t want = 0xffcc6633u;			/* bytes R G B A = 33 66 cc ff */
+	const uint32_t dx = 8, dy = 4, bw = 16, bh = 8;
+	vm_offset_t va = 0;
+	uint64_t pa = 0;
+
+	if (ring_va == 0 || ring_pa == 0) {
+		printf("WHYRED GPU: step 20 needs steps 10-12\n");
+		return;
+	}
+	if (whyred_alloc(0x2000, PAGE_MASK, &va, &pa)) {
+		printf("WHYRED GPU: no pages for the images\n");
+		return;
+	}
+	for (int v = 0; v < 3; v++) {
+		uint64_t src_pa = pa, dst_pa = pa + 0x1000;
+		volatile uint32_t *dst = (volatile uint32_t *)(va + 0x1000);
+		uint32_t inside = 0, outside = 0, first = 0;
+
+		for (uint32_t i = 0; i < IMG_W * IMG_H; i++) {
+			dst[i] = 0xdeadbeefu;
+		}
+		flush_dcache64((addr64_t)dst_pa, IMG_BYTES, TRUE);
+		whyred_announce("step 20: submit a 2D solid fill variant");
+		ring_reg(0xe141u, 0x8);
+		ring_reg(0x2100u, cntl[v]);
+		ring_reg(0x2180u, cntl[v]);
+		ring_reg(0x2184u, 0x9);
+		ring_reg(0xe140u, 1u << 17);
+		ring_reg(0x0cc6u, 1u << 1);
+		ring_reg(R_SP_MODE_CNTL, 0xc);
+		ring_reg(R_TPL1_MODE_CNTL, 0x244u | (1u << 7));
+		ring_reg(R_HLSQ_MODE_CNTL, 0x2);
+		ring_reg(0xe000u, 0x181);
+		ring_pkt7(CP_SET_RENDER_MODE, 1);
+		ring_put(5);
+		ring_pkt4(0x2101u, 4);				/* RB_2D_SRC_SOLID_DW0..3 */
+		for (int i = 0; i < 4; i++) {
+			ring_put(colour[v][i]);
+		}
+		ring_pkt4(0x2107u, 9);
+		ring_put(0x30);
+		ring_put((uint32_t)src_pa);
+		ring_put((uint32_t)(src_pa >> 32));
+		ring_put((IMG_PITCH >> 6) | ((IMG_BYTES >> 6) << 16));
+		for (int i = 0; i < 5; i++) {
+			ring_put(0);
+		}
+		ring_reg(0x2181u, 0x30);
+		ring_pkt4(0x2110u, 9);
+		ring_put(0x30);
+		ring_put((uint32_t)dst_pa);
+		ring_put((uint32_t)(dst_pa >> 32));
+		ring_put((IMG_PITCH >> 6) | ((IMG_BYTES >> 6) << 16));
+		for (int i = 0; i < 5; i++) {
+			ring_put(0);
+		}
+		ring_reg(0x2182u, 0x30);
+		ring_pkt4(0x2000u, 5);
+		ring_put(0x30);
+		ring_put(IMG_W | (IMG_H << 15));
+		ring_put((uint32_t)src_pa);
+		ring_put((uint32_t)(src_pa >> 32));
+		ring_put((IMG_PITCH >> 6) << 9);
+		ring_reg(0x2040u, 0x30u << 3);
+		ring_pkt7(CP_BLIT, 5);
+		ring_put(0);					/* BLIT_OP_FILL */
+		ring_put(0);
+		ring_put(0);
+		ring_put(dx | (dy << 16));
+		ring_put((dx + bw - 1) | ((dy + bh - 1) << 16));
+		ring_pkt7(CP_SET_RENDER_MODE, 1);
+		ring_put(8);
+		ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+		ring_pkt7(CP_EVENT_WRITE, 4);
+		ring_put(0x1du | (1u << 30));
+		ring_put((uint32_t)(fence_pa + 0x100));
+		ring_put((uint32_t)((fence_pa + 0x100) >> 32));
+		ring_put(0x5678u);
+		ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+		ring_pkt4(R_UCHE_INVALIDATE_MIN, 5);
+		ring_put(0);
+		ring_put(0);
+		ring_put(0);
+		ring_put(0);
+		ring_put(0x12);
+		ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+		ring_pkt7(CP_EVENT_WRITE, 4);
+		ring_put(0x4u | (1u << 30));
+		ring_put((uint32_t)(fence_pa + 0xc0));
+		ring_put((uint32_t)((fence_pa + 0xc0) >> 32));
+		ring_put(0x1234u);
+		ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+		if (ring_submit("solid fill") != 0) {
+			printf("WHYRED GPU: variant %d: the CP did not consume the fill\n", v);
+			return;
+		}
+		whyred_wait(50);
+		flush_dcache64((addr64_t)dst_pa, IMG_BYTES, TRUE);
+		for (uint32_t y = 0; y < IMG_H; y++) {
+			for (uint32_t x = 0; x < IMG_W; x++) {
+				uint32_t got = dst[y * IMG_W + x];
+				bool in_box = x >= dx && x < dx + bw && y >= dy && y < dy + bh;
+				if (in_box) {
+					if (got == want) {
+						inside++;
+					} else if (first == 0) {
+						first = got;
+					}
+				} else if (got == 0xdeadbeefu) {
+					outside++;
+				}
+			}
+		}
+		printf("WHYRED GPU: fill variant %d: %u of %u box pixels right, %u of %u outside untouched%s"
+		    "; first wrong %08x, pixel(8,4) %08x\n", v, inside, bw * bh, outside,
+		    IMG_W * IMG_H - bw * bh,
+		    (inside == bw * bh && outside == IMG_W * IMG_H - bw * bh) ? " (ALL CORRECT)" : "",
+		    first, dst[dy * IMG_W + dx]);
+	}
+}
+
+/*
+ * Step 21 (M4.3): the first 3D draw. One triangle (TRILIST, 3 vertices from a
+ * vertex buffer) is drawn in sysmem mode (no binning, RB_CNTL BYPASS) into a
+ * 64x64 RGBA8 linear target with a hand-assembled VS (position passes straight
+ * from the fetched r0.xyzw to the output) and FS (four immediate moves into
+ * r0.xyzw, the colour output). State order follows Gallium fd5 (fd5_emit_restore,
+ * emit_sysmem_prep, fd5_program_emit, fd5_emit_state, fd5_draw_emit) as a
+ * behaviour reference, no code taken. The CPU then checks pixels inside the
+ * triangle, outside it, and that the sentinel survives elsewhere.
+ */
+#define D_W 64u
+#define D_H 64u
+#define D_PITCH (D_W * 4u)
+#define D_BYTES (D_PITCH * D_H)
+#define D_COLOUR 0xff9933ffu	/* R 1.0, G 0.2, B 0.6, A 1.0 as RGBA8 */
+#define D_SENTINEL 0xdeadbeefu
+
+static int
+chan_ok(uint32_t got, uint32_t want)
+{
+	for (int s = 0; s < 32; s += 8) {
+		int a = (int)((got >> s) & 0xff), b = (int)((want >> s) & 0xff);
+		if (a - b > 1 || b - a > 1) {
+			return 0;
+		}
+	}
+	return 1;
+}
+
+static int
+chan_tol(uint32_t got, uint32_t want, int tol)
+{
+	for (int s = 0; s < 32; s += 8) {
+		int a = (int)((got >> s) & 0xff), b = (int)((want >> s) & 0xff);
+		if (a - b > tol || b - a > tol) {
+			return 0;
+		}
+	}
+	return 1;
+}
+
+/* Queue a fence write and wait for it: proves the ME executed everything before it. */
+static int
+draw_mark(const char *what)
+{
+	static uint32_t seq;
+	volatile uint32_t *m = (volatile uint32_t *)(rptr_va + 0x180);
+	uint32_t want = 0xd0000000u | ++seq;
+
+	*m = 0;
+	flush_dcache64((addr64_t)(fence_pa + 0x80), 64, TRUE);
+	ring_pkt7(CP_MEM_WRITE, 3);
+	ring_put((uint32_t)(fence_pa + 0x80));
+	ring_put((uint32_t)((fence_pa + 0x80) >> 32));
+	ring_put(want);
+	ring_submit(what);
+	for (int k = 0; k < 40; k++) {
+		flush_dcache64((addr64_t)(fence_pa + 0x80), 64, TRUE);
+		if (*m == want) {
+			printf("WHYRED GPU: mark %s ok\n", what);
+			return 0;
+		}
+		whyred_wait(5);
+	}
+	printf("WHYRED GPU: the ME is stuck BEFORE mark %s (fence %08x)\n", what, *m);
+	return -1;
+}
+
+/* mov r1.x/y/z = address lo/hi/value; two (rpt5)nop; stg; (rpt5)nop; end (hand-assembled, as in the compute test) */
+static int
+shader_store_tail(uint32_t *p, int at, uint64_t addr, uint32_t val)
+{
+	shader_mov(&p[at], 4, (uint32_t)addr);
+	shader_mov(&p[at + 2], 5, (uint32_t)(addr >> 32));
+	shader_mov(&p[at + 4], 6, val);
+	p[at + 6] = 0;
+	p[at + 7] = 0x00000500u;
+	p[at + 8] = 0;
+	p[at + 9] = 0x00000500u;
+	p[at + 10] = 0x01800000u | (6u << 1);	/* stg.u32 g[r1.x], r1.z, 1 */
+	p[at + 11] = 0xc0c60100u | (4u << 9);
+	p[at + 12] = 0;
+	p[at + 13] = 0x00000500u;
+	p[at + 14] = 0;
+	p[at + 15] = 0x03000000u;		/* end */
+	return at + 16;
+}
+
+static void
+step21_draw(int mode)
+{
+	static const uint32_t vtx[3][4] = {
+		{ 0xbf000000u, 0xbf000000u, 0, 0x3f800000u },	/* (-0.5,-0.5) -> px (16,16) */
+		{ 0x3f000000u, 0xbf000000u, 0, 0x3f800000u },	/* ( 0.5,-0.5) -> px (48,16) */
+		{ 0xbf000000u, 0x3f000000u, 0, 0x3f800000u },	/* (-0.5, 0.5) -> px (16,48) */
+	};
+	vm_offset_t va = 0;
+	uint64_t pa = 0, vs_pa, fs_pa, vb_pa, rt_pa;
+	uint32_t *vs, *fs, *vb;
+	volatile uint32_t *rt;
+	uint32_t in_ok = 0, in_n = 0, out_ok = 0, out_n = 0, first_bad = 0xffffffffu;
+	uint32_t pc0[4] = { 0, 0, 0, 0 };
+	const uint32_t hbb = 1;	/* highest bank bit 14 - 13, as the 2D steps use */
+	const uint32_t texel_want = 0xff905077u;	/* texel (2,1) of the 4x4 texture */
+	const bool dbg = mode == 3;	/* colour = the interpolated (u, v), no texture */
+	const bool tex = mode == 1 || mode == 2;
+	const bool vary = mode >= 2;
+	const uint32_t want = tex ? texel_want : D_COLOUR;
+	uint32_t bad_want = 0;
+
+	if (ring_va == 0 || ring_pa == 0) {
+		printf("WHYRED GPU: step 21 needs steps 10-12\n");
+		return;
+	}
+	if (whyred_alloc(0xa000, PAGE_MASK, &va, &pa)) {
+		printf("WHYRED GPU: no pages for the draw\n");
+		return;
+	}
+	vs_pa = pa;
+	fs_pa = pa + 0x1000;
+	vb_pa = pa + 0x2000;
+	rt_pa = pa + 0x3000;
+	vs = (uint32_t *)va;
+	fs = (uint32_t *)(va + 0x1000);
+	vb = (uint32_t *)(va + 0x2000);
+	rt = (volatile uint32_t *)(va + 0x3000);
+
+	/* VS: the position is already in r0.xyzw; it also stores a marker word */
+	shader_store_tail(vs, 0, pa + 0x7000, 0xa5a50002u);
+	if (dbg) {
+		fs[0] = 0x00002000u;				/* bary.f (ei)r0.z, 0, r0.x : colour = (i, j, u, v) */
+		fs[1] = 0x47328002u;
+		fs[2] = 0x00002001u;				/* bary.f (ei)r0.w, 1, r0.x */
+		fs[3] = 0x47328003u;
+		fs[4] = 0;
+		fs[5] = 0x10001500u;				/* (ss)(sy)(rpt5)nop */
+		shader_store_tail(fs, 6, pa + 0x7040, 0xf5f50001u);
+	} else if (tex) {
+		uint32_t *tx = (uint32_t *)(va + 0x8000);
+
+		/* 4x4 RGBA8 linear texture, pitch 256 bytes (64 texels, as fdl5 aligns); texel(x,y) = ff | (x*0x40+0x10) | (y*0x40+0x10) | 77 */
+		for (uint32_t y = 0; y < 4; y++) {
+			for (uint32_t x = 0; x < 4; x++) {
+				tx[y * 64 + x] = 0xff000000u | ((x * 0x40 + 0x10) << 16) |
+				    ((y * 0x40 + 0x10) << 8) | 0x77u;
+			}
+		}
+		flush_dcache64((addr64_t)(pa + 0x8000), 0x2000, TRUE);
+		/* FS: r1.xy = (0.625, 0.375) or the interpolated varying; sam (f32)(xyzw)r0.x, r1.x, s#0, t#0 */
+		if (vary) {
+			fs[0] = 0x00002000u;			/* bary.f (ei)r1.x, 0, r0.x */
+			fs[1] = 0x47328004u;
+			fs[2] = 0x00002001u;			/* bary.f (ei)r1.y, 1, r0.x */
+			fs[3] = 0x47328005u;
+			fs[4] = 0;
+			fs[5] = 0x10001500u;			/* (ss)(sy)(rpt5)nop */
+		} else {
+			shader_mov(&fs[0], 4, 0x3f200000u);
+			shader_mov(&fs[2], 5, 0x3ec00000u);
+			fs[4] = 0;
+			fs[5] = 0x00000500u;
+		}
+		fs[6] = 1u | (4u << 1);				/* FULL, SRC1 r1.x, SAMP 0, TEX 0 */
+		fs[7] = 0xa0c01f00u;				/* sam, f32, wrmask xyzw, dst r0.x */
+		fs[8] = 0;
+		fs[9] = 0x10000000u;				/* (sy)nop */
+		shader_store_tail(fs, 10, pa + 0x7040, 0xf5f50001u);
+	} else {
+		/* FS: r0.xyzw = (1.0, 0.2, 0.6, 1.0), and it stores a marker word */
+		shader_mov(&fs[0], 0, 0x3f800000u);
+		shader_mov(&fs[2], 1, 0x3e4ccccdu);
+		shader_mov(&fs[4], 2, 0x3f19999au);
+		shader_mov(&fs[6], 3, 0x3f800000u);
+		shader_store_tail(fs, 8, pa + 0x7040, 0xf5f50001u);
+	}
+	for (int i = 0; i < 3; i++) {
+		static const uint32_t uvs[3][2] = { { 0, 0 }, { 0x3f800000u, 0 }, { 0, 0x3f800000u } };
+
+		for (int c = 0; c < 4; c++) {
+			vb[i * (vary ? 8 : 4) + c] = vtx[i][c];
+		}
+		if (vary) {
+			vb[i * 8 + 4] = uvs[i][0];
+			vb[i * 8 + 5] = uvs[i][1];
+			vb[i * 8 + 6] = 0;
+			vb[i * 8 + 7] = 0x3f800000u;
+		}
+	}
+	for (uint32_t i = 0; i < D_W * D_H; i++) {
+		rt[i] = D_SENTINEL;
+	}
+	flush_dcache64((addr64_t)vs_pa, 0x1000, TRUE);
+	flush_dcache64((addr64_t)fs_pa, 0x1000, TRUE);
+	flush_dcache64((addr64_t)vb_pa, 0x1000, TRUE);
+	flush_dcache64((addr64_t)rt_pa, D_BYTES, TRUE);
+
+	whyred_announce("step 21: submit the first 3D draw");
+	/* fd5_emit_restore (the non-default part) */
+	ring_pkt7(CP_SET_RENDER_MODE, 5);
+	ring_put(1);						/* BYPASS */
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	if (draw_mark("bypass")) {
+		return;
+	}
+	ring_pkt4(R_UCHE_INVALIDATE_MIN, 5);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0x12);
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	ring_reg(R_HLSQ_UPDATE_CNTL, 0xfffff);
+	if (draw_mark("ucheflush")) {
+		return;
+	}
+	ring_reg(0xe38cu, 0xffffffffu);				/* PC_RESTART_INDEX */
+	ring_reg(0xe388u, 0x12);				/* PC_RASTER_CNTL */
+	ring_pkt4(0xe091u, 2);					/* GRAS_SU_POINT_MINMAX, _SIZE */
+	ring_put(0x4000u | (0x3fffu << 16));			/* min 1.0, max 4092.0 (4.8 fixed) approx */
+	ring_put(0x8);
+	ring_reg(0xe099u, 0);					/* GRAS_SU_CONSERVATIVE_RAS_CNTL */
+	ring_reg(0xe0a4u, 0);					/* GRAS_SC_SCREEN_SCISSOR_CNTL */
+	ring_reg(0xe58au, 0);					/* SP_VS_CONFIG_MAX_CONST */
+	ring_reg(0xe58bu, 0);					/* SP_FS_CONFIG_MAX_CONST */
+	ring_reg(0x0cc6u, 0x40u | (hbb << 1));			/* RB_MODE_CNTL (hbb field at bit 1) */
+	ring_reg(0x0cc4u, 0x100000u);				/* RB_DBG_ECO_CNTL */
+	ring_reg(0x0e42u, 0);					/* VFD_MODE_CNTL */
+	ring_reg(0x0d02u, 0x1f);				/* PC_MODE_CNTL */
+	ring_reg(R_SP_MODE_CNTL, 0x1e);
+	ring_reg(R_SP_DBG_ECO_CNTL, 0x40000800u);
+	ring_reg(R_TPL1_MODE_CNTL, 0x444u | (hbb << 7));
+	ring_pkt4(R_HLSQ_TIMEOUT_0, 2);
+	ring_put(0x80);
+	ring_put(0);
+	ring_reg(0x0e60u, 1u << 10);				/* VPC_DBG_ECO_CNTL: ALLFLATOPTDIS */
+	ring_reg(R_HLSQ_MODE_CNTL, 1);
+	ring_reg(0x0e62u, 0);					/* VPC_MODE_CNTL */
+	ring_reg(0xe0a1u, 0);					/* GRAS_SC_BIN_CNTL */
+	ring_reg(0xe2a0u, 0xff);				/* VPC_FS_PRIMITIVEID_CNTL */
+	ring_reg(0xe21cu, 0);					/* RB_CLEAR_CNTL */
+	if (draw_mark("restore")) {
+		return;
+	}
+	/* emit_sysmem_prep */
+	ring_pkt7(0x1du, 1);					/* CP_SKIP_IB2_ENABLE_GLOBAL */
+	ring_put(0);
+	if (draw_mark("skipib2")) {
+		return;
+	}
+	ring_pkt7(CP_EVENT_WRITE, 1);
+	ring_put(0x19);						/* PC_CCU_INVALIDATE_COLOR */
+	if (draw_mark("ccuinv")) {
+		return;
+	}
+	ring_reg(0xe3b0u, 1);					/* PC_POWER_CNTL: sp cores - 1 */
+	ring_reg(0xe4f0u, 1);					/* VFD_POWER_CNTL */
+	if (draw_mark("power")) {
+		return;
+	}
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	ring_reg(0x0cc7u, 0x10000000u);				/* RB_CCU_CNTL: sysmem (Mesa a5xx) */
+	ring_reg(0xe140u, 1u << 17);				/* RB_CNTL: BYPASS */
+	if (draw_mark("rbcntl")) {
+		return;
+	}
+	ring_pkt4(0xe0eau, 2);					/* GRAS_SC_WINDOW_SCISSOR_TL, BR */
+	ring_put(0);
+	ring_put((D_W - 1) | ((D_H - 1) << 16));
+	ring_pkt4(0xe211u, 2);					/* RB_RESOLVE_CNTL_1, _2 */
+	ring_put(0);
+	ring_put((D_W - 1) | ((D_H - 1) << 16));
+	ring_reg(0xe1d0u, 0);					/* RB_WINDOW_OFFSET */
+	if (draw_mark("winoff")) {
+		return;
+	}
+	ring_reg(0xe2a2u, 0);					/* VPC_SO_OVERRIDE */
+	if (draw_mark("soover")) {
+		return;
+	}
+	ring_pkt7(0x64u, 1);					/* CP_SET_VISIBILITY_OVERRIDE */
+	ring_put(1);
+	if (draw_mark("prep")) {
+		return;
+	}
+	/* emit_mrt (one target, linear RGBA8) and emit_msaa (one sample) */
+	ring_pkt4(0xe152u, 5);					/* RB_MRT_BUF_INFO(0) .. BASE */
+	ring_put(0x30);
+	ring_put(D_PITCH >> 6);					/* PITCH and ARRAY_PITCH are shr 6 */
+	ring_put(D_BYTES >> 6);
+	ring_put((uint32_t)rt_pa);
+	ring_put((uint32_t)(rt_pa >> 32));
+	ring_reg(0xe5d3u, 0x30);				/* SP_FS_MRT_REG(0) */
+	ring_pkt4(0xe704u, 2);					/* TPL1_TP_RAS_MSAA_CNTL, _DEST_ */
+	ring_put(0);
+	ring_put(4);
+	ring_pkt4(0xe142u, 2);					/* RB_RAS_MSAA_CNTL, _DEST_ */
+	ring_put(0);
+	ring_put(4);
+	ring_pkt4(0xe0a2u, 2);					/* GRAS_SC_RAS_MSAA_CNTL, _DEST_ */
+	ring_put(0);
+	ring_put(4);
+	if (draw_mark("mrt")) {
+		return;
+	}
+	/* fd5_emit_state: render targets, blend, depth/stencil, viewport, scissor */
+	ring_reg(0xe147u, 0xf);					/* RB_RENDER_COMPONENTS: RT0 rgba */
+	ring_reg(0xe1a8u, 0);					/* RB_ALPHA_CONTROL */
+	ring_reg(0xe1c0u, 0);					/* RB_STENCIL_CONTROL */
+	ring_pkt4(0xe1c6u, 2);
+	ring_put(0);
+	ring_put(0);
+	ring_reg(0xe1b1u, 0);					/* RB_DEPTH_CNTL */
+	ring_reg(0xe1b0u, 0);					/* RB_DEPTH_PLANE_CNTL */
+	ring_reg(0xe094u, 0);					/* GRAS_SU_DEPTH_PLANE_CNTL */
+	ring_pkt4(0xe0aau, 2);					/* GRAS_SC_SCREEN_SCISSOR_TL_0, BR_0 */
+	ring_put(0);
+	ring_put((D_W - 1) | ((D_H - 1) << 16));
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	ring_pkt4(0xe010u, 6);					/* GRAS_CL_VPORT X/Y/Z OFFSET, SCALE */
+	ring_put(0x42000000u);					/* x offset 32.0 */
+	ring_put(0x42000000u);					/* x scale 32.0 */
+	ring_put(0x42000000u);					/* y offset 32.0 */
+	ring_put(0x42000000u);					/* y scale 32.0 */
+	ring_put(0);						/* z offset 0 */
+	ring_put(0x3f800000u);					/* z scale 1.0 */
+	ring_pkt4(0xe0cau, 2);					/* GRAS_SC_VIEWPORT_SCISSOR_TL_0, BR_0 */
+	ring_put(0);
+	ring_put((D_W - 1) | ((D_H - 1) << 16));
+	ring_reg(0xe090u, 0);					/* GRAS_SU_CNTL: no culling */
+	ring_pkt4(0xe095u, 3);					/* GRAS_SU_POLY_OFFSET_* */
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_reg(0xe384u, vary ? 6 : 4);					/* PC_PRIMITIVE_CNTL: STRIDE_IN_VPC 4 */
+	ring_reg(0xe000u, 0);					/* GRAS_CL_CNTL */
+	ring_reg(0xe006u, 0);					/* GRAS_CL_GUARDBAND_CLIP_ADJ */
+	ring_reg(0xe146u, 1);					/* RB_FS_OUTPUT_CNTL: MRT 1 */
+	ring_reg(0xe5cau, 1u | (0xfcu << 5) | (0xfcu << 13));	/* SP_FS_OUTPUT_CNTL */
+	ring_reg(0xe150u, (3u << 3) | (0xfu << 7));		/* RB_MRT_CONTROL(0): ROP_COPY, all comps */
+	ring_reg(0xe151u, 0x10001u);				/* RB_MRT_BLEND_CONTROL(0): src ONE, dst ZERO */
+	ring_reg(0xe5c9u, 0x100);				/* SP_BLEND_CNTL */
+	if (draw_mark("state")) {
+		return;
+	}
+	ring_reg(0xe1a9u, 0xffff0100u);				/* RB_BLEND_CNTL: sample mask, independent */
+	/* fd5_program_emit: VS in the SP, one output (the position), FS writes r0 */
+	ring_pkt4(0xe78bu, 5);					/* HLSQ_VS/FS/HS/DS/GS_CONFIG */
+	ring_put(1);
+	ring_put(1);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_reg(0xe790u, 0);					/* HLSQ_CS_CONFIG */
+	ring_pkt4(0xe791u, 5);					/* HLSQ_VS/FS/HS/DS/GS_CNTL: INSTRLEN 1 << 1 */
+	ring_put(1u << 1);
+	ring_put(1u << 1);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_pkt4(0xe584u, 5);					/* SP_VS/FS/HS/DS/GS_CONFIG */
+	ring_put(1);
+	ring_put(1);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_reg(R_SP_CS_CONFIG, 0);
+	ring_pkt4(0xe7c3u, 2);					/* HLSQ_VS_CONSTLEN, _INSTRLEN */
+	ring_put(0);
+	ring_put(1);
+	ring_pkt4(0xe7d7u, 2);					/* HLSQ_FS_CONSTLEN, _INSTRLEN */
+	ring_put(0);
+	ring_put(1);
+	ring_reg(0xe590u, ((vary ? 3u : 2u) << 10) | (1u << 2) | 0x2);	/* SP_VS_CTRL_REG0 */
+	ring_pkt4(0xe294u, 4);					/* VPC_VAR_DISABLE(0..3): no varyings */
+	ring_put(vary ? 0xfffffffcu : 0xffffffffu);
+	ring_put(0xffffffffu);
+	ring_put(0xffffffffu);
+	ring_put(0xffffffffu);
+	ring_reg(0xe593u, vary ? 0x0f000308u : 0xf00u);				/* SP_VS_OUT_REG(0): A = r0, mask xyzw */
+	ring_reg(0xe5a3u, vary ? 0x200u : 0);					/* SP_VS_VPC_DST_REG(0): OUTLOC0 0 */
+	ring_pkt4(0xe5acu, 2);					/* SP_VS_OBJ_START */
+	ring_put((uint32_t)vs_pa);
+	ring_put((uint32_t)(vs_pa >> 32));
+	if (draw_mark("prog1")) {
+		return;
+	}
+	ring_pkt7(CP_LOAD_STATE4, 3);				/* VS into the SP */
+	ring_put((8u << 18) | (1u << 22) | (2u << 16));
+	ring_put((uint32_t)vs_pa);
+	ring_put((uint32_t)(vs_pa >> 32));
+	ring_reg(0xe385u, 0);					/* PC_PRIM_VTX_CNTL */
+	ring_reg(0xe592u, vary ? 2 : 1);					/* SP_PRIMITIVE_CNTL: VSOUT 1 */
+	ring_reg(0xe280u, vary ? (6u | 0x800u | 0x10000u) : (4u | 0x10000u));			/* VPC_CNTL_0 */
+	ring_pkt4(0xe5c3u, 2);					/* SP_FS_OBJ_START */
+	ring_put((uint32_t)fs_pa);
+	ring_put((uint32_t)(fs_pa >> 32));
+	ring_pkt4(0xe784u, 5);					/* HLSQ_CONTROL_0..4_REG */
+	ring_put(0x880);
+	ring_put(63);
+	ring_put(0xfcfcfcfcu);
+	ring_put(dbg ? 0xfcfcfc00u : vary ? 0xfcfcfc00u : 0xfcfcfcfcu);		/* HLSQ_CONTROL_3: IJ_PERSP_PIXEL = r0.x */
+	ring_put(0xfcfcfcfcu);
+	ring_reg(0xe5c0u, 0x40002u | (1u << 2) | ((dbg ? 3u : 2u) << 10) | (vary ? 0x10000u : 0));	/* SP_FS_CTRL_REG0 */
+	ring_reg(R_HLSQ_UPDATE_CNTL, 0x20fffffu);
+	ring_reg(0xe298u, 0xffffu);				/* VPC_GS_SIV_CNTL */
+	ring_reg(R_SP_SP_CNTL, 0x10);
+	ring_reg(0xe005u, vary ? 1 : 0);					/* GRAS_CNTL */
+	ring_pkt4(0xe144u, 2);					/* RB_RENDER_CONTROL0, 1 */
+	ring_put(vary ? 1 : 0);
+	ring_put(0);
+	ring_pkt4(0xe5cbu, 8);					/* SP_FS_OUTPUT_REG(0..7): colour in r0 */
+	ring_put(0);
+	for (int i = 1; i < 8; i++) {
+		ring_put(0xfc);
+	}
+	ring_reg(0xe29du, vary ? (0xff00u | 2u) : 0xff00u);				/* VPC_PACK: NUMNONPOSVAR 0, PSIZELOC off */
+	ring_pkt4(0xe282u, 8);					/* VPC_VARYING_INTERP_MODE(0..7) */
+	for (int i = 0; i < 8; i++) {
+		ring_put(0);
+	}
+	ring_pkt4(0xe28au, 8);					/* VPC_VARYING_PS_REPL_MODE(0..7) */
+	for (int i = 0; i < 8; i++) {
+		ring_put(0);
+	}
+	ring_reg(0xe001u, 0);					/* GRAS_VS_CL_CNTL */
+	ring_reg(0xe29au, 0);					/* VPC_CLIP_CNTL */
+	ring_reg(0xe389u, 0);					/* PC_CLIP_CNTL */
+	ring_pkt7(CP_LOAD_STATE4, 3);				/* FS into the SP */
+	ring_put((0xcu << 18) | (1u << 22) | (2u << 16));
+	ring_put((uint32_t)fs_pa);
+	ring_put((uint32_t)(fs_pa >> 32));
+	if (draw_mark("prog2")) {
+		return;
+	}
+	if (tex) {
+		ring_pkt7(CP_LOAD_STATE4, 3 + 4);		/* sampler: nearest, clamp to edge */
+		ring_put((4u << 18) | (1u << 22));		/* SS4_DIRECT, SB4_FS_TEX, 1 unit */
+		ring_put(0);					/* ST4_SHADER */
+		ring_put(0);
+		ring_put(0x920u);				/* WRAP_S/T/R = CLAMP_TO_EDGE */
+		ring_put((32u << 8) | (32u << 20));		/* MAX_LOD, MIN_LOD = 0.125 */
+		ring_put(0);
+		ring_put(0);
+		ring_pkt7(CP_LOAD_STATE4, 3 + 12);		/* texture constants */
+		ring_put((4u << 18) | (1u << 22));
+		ring_put(1);					/* ST4_CONSTANTS */
+		ring_put(0);
+		ring_put(0x30u << 22 | (1u << 7) | (2u << 10) | (3u << 13));	/* RGBA8_UNORM, swizzle xyzw */
+		ring_put(4u | (4u << 15));			/* 4x4 */
+		ring_put((1u << 29) | (256u << 7) | 2u);	/* 2D, pitch 256, PITCHALIGN log2(256/64) */
+		ring_put(2);					/* ARRAY_PITCH: 8 KB layer >> 12 */
+		ring_put((uint32_t)(pa + 0x8000));		/* BASE_LO */
+		ring_put((uint32_t)((pa + 0x8000) >> 32) | (1u << 17));	/* BASE_HI, DEPTH 1 */
+		for (int i = 0; i < 6; i++) {
+			ring_put(0);
+		}
+		ring_reg(0xe750u, 1);				/* TPL1_FS_TEX_COUNT */
+	}
+	ring_pkt4(0xe401u, 5);					/* VFD_CONTROL_1..5 */
+	ring_put(0xfcu | (0xfcu << 8) | 0xfc0000u);
+	ring_put(0xfcfcu);
+	ring_put(0xfcfcu);
+	ring_put(0xfcu);
+	ring_put(0);
+	/* fd5_emit_vertex_bufs: one fetch, float4 into r0.xyzw */
+	ring_pkt4(0xe40au, vary ? 8 : 4);			/* VFD_FETCH(0..) */
+	ring_put((uint32_t)vb_pa);
+	ring_put((uint32_t)(vb_pa >> 32));
+	ring_put(vary ? 96 : 48);
+	ring_put(vary ? 32 : 16);
+	if (vary) {
+		ring_put((uint32_t)(vb_pa + 16));
+		ring_put((uint32_t)((vb_pa + 16) >> 32));
+		ring_put(80);
+		ring_put(32);
+	}
+	ring_pkt4(0xe48au, vary ? 4 : 2);			/* VFD_DECODE(0..) */
+	ring_put(0u | (0x82u << 20) | (1u << 30) | (1u << 31));
+	ring_put(1);
+	if (vary) {
+		ring_put(1u | (0x82u << 20) | (1u << 30) | (1u << 31));
+		ring_put(1);
+	}
+	ring_reg(0xe4cau, 0xfu | (0u << 4));			/* VFD_DEST_CNTL(0): xyzw -> r0 */
+	if (vary) {
+		ring_reg(0xe4cbu, 0xfu | (8u << 4));		/* VFD_DEST_CNTL(1): xyzw -> r2 (the VS marker tail uses r1) */
+	}
+	ring_reg(0xe400u, vary ? 2 : 1);			/* VFD_CONTROL_0: VTXCNT */
+	ring_pkt4(0xe408u, 2);					/* VFD_INDEX_OFFSET, _INSTANCE_START_OFFSET */
+	ring_put(0);
+	ring_put(0);
+	ring_reg(0xe38cu, 0xffffffffu);				/* PC_RESTART_INDEX */
+	/* fd5_emit_render_cntl and the draw */
+	if (draw_mark("vtx")) {
+		return;
+	}
+	/* RB perf counters: 0 TOTAL_PASS, 1 C_WRITE, 2 STALL_CYCLES_CCU, 3 BUSY_CYCLES */
+	wr(gpu, 0x0464u * 4, 1);
+	wr(gpu, 0x0cd0u * 4, 17);
+	wr(gpu, 0x0cd1u * 4, 16);
+	wr(gpu, 0x0cd2u * 4, 1);
+	wr(gpu, 0x0cd3u * 4, 0);
+	for (int var = 0; var < 4; var++) {
+		static const uint32_t rc_var[4] = { 0x8, 0, 0x8, 0 };
+		static const uint32_t sc_var[4] = { 0x8, 0x8, 0, 0 };
+		static const uint32_t ccu_var[4] = { 0x08000000u, 0x08000000u, 0x08000000u, 0x04000000u };
+		in_ok = in_n = out_ok = out_n = 0;
+		first_bad = 0xffffffffu;
+		printf("WHYRED GPU: draw variant %d: RB_RENDER_CNTL %x GRAS_SC_CNTL %x\n", var,
+		    rc_var[var], sc_var[var]);
+		for (uint32_t i = 0; i < D_W * D_H; i++) {
+			rt[i] = D_SENTINEL;
+		}
+		flush_dcache64((addr64_t)rt_pa, D_BYTES, TRUE);
+		*(volatile uint32_t *)(va + 0x7000) = 0;
+		*(volatile uint32_t *)(va + 0x7040) = 0;
+		flush_dcache64((addr64_t)(pa + 0x7000), 0x80, TRUE);
+		for (int c = 0; c < 4; c++) {
+			pc0[c] = rd(gpu, (0x0440u + 2 * c) * 4);
+		}
+		ring_reg(0xe141u, rc_var[var]);					/* RB_RENDER_CNTL */
+		ring_reg(0xe0a0u, sc_var[var]);					/* GRAS_SC_CNTL */
+		ring_pkt7(0x38u, 3);					/* CP_DRAW_INDX_OFFSET */
+		ring_put(4u | (2u << 6));				/* TRILIST, AUTO_INDEX, ignore visibility */
+		ring_put(1);						/* instances */
+		ring_put(3);						/* indices */
+		/* emit_sysmem_fini: CCU flush so the colour cache reaches memory */
+		ring_pkt7(0x1du, 1);
+		ring_put(0);
+		ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+		ring_pkt7(CP_EVENT_WRITE, 4);
+		ring_put(0x1du | (1u << 30));				/* PC_CCU_FLUSH_COLOR_TS */
+		ring_put((uint32_t)(fence_pa + 0x100));
+		ring_put((uint32_t)((fence_pa + 0x100) >> 32));
+		ring_put(0x9abcu);
+		ring_pkt7(CP_EVENT_WRITE, 4);
+		ring_put(0x1cu | (1u << 30));				/* PC_CCU_FLUSH_DEPTH_TS */
+		ring_put((uint32_t)(fence_pa + 0x140));
+		ring_put((uint32_t)((fence_pa + 0x140) >> 32));
+		ring_put(0x9abdu);
+		ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+		ring_pkt4(R_UCHE_INVALIDATE_MIN, 5);
+		ring_put(0);
+		ring_put(0);
+		ring_put(0);
+		ring_put(0);
+		ring_put(0x12);
+		ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+		ring_pkt7(CP_EVENT_WRITE, 4);
+		ring_put(0x4u | (1u << 30));				/* CACHE_FLUSH_TS */
+		ring_put((uint32_t)(fence_pa + 0xc0));
+		ring_put((uint32_t)((fence_pa + 0xc0) >> 32));
+		ring_put(0x2345u);
+		ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+		if (ring_submit("3D draw") != 0) {
+			printf("WHYRED GPU: the CP did not consume the draw\n");
+			return;
+		}
+		whyred_wait(100);
+		flush_dcache64((addr64_t)rt_pa, D_BYTES, TRUE);
+		for (uint32_t y = 0; y < D_H; y++) {
+			for (uint32_t x = 0; x < D_W; x++) {
+				uint32_t got = rt[y * D_W + x];
+				/* the triangle (16,16) (48,16) (16,48): x + y < 64, x,y >= 16; keep a
+				 * 2 pixel margin from the edges so rasterisation rules do not matter */
+				bool inside = x >= 18 && y >= 18 && x + y <= 61;
+				bool outside = x < 14 || y < 14 || x + y >= 67;
+				uint32_t pw = want;
+				bool skip = false;
+
+				if (vary && inside) {
+					/* texel = ((x-16)>>3, (y-16)>>3); skip the pixels next to a texel edge */
+					uint32_t fx = (x - 16) & 7, fy = (y - 16) & 7;
+
+					skip = fx == 0 || fx == 7 || fy == 0 || fy == 7;
+					pw = 0xff000000u | ((((x - 16) >> 3) * 0x40 + 0x10) << 16) |
+					    ((((y - 16) >> 3) * 0x40 + 0x10) << 8) | 0x77u;
+				}
+				if (dbg && inside) {
+					uint32_t ur = (2 * x + 1 - 32) * 255 / 64, vg = (2 * y + 1 - 32) * 255 / 64;
+
+					pw = 0xff000000u | (vg << 8) | ur;
+				}
+				if (inside && skip) {
+					continue;
+				}
+				if (inside) {
+					in_n++;
+					if (dbg ? chan_tol(got, pw, 5) : chan_ok(got, pw)) {
+						in_ok++;
+					} else if (first_bad == 0xffffffffu) {
+						first_bad = y * D_W + x;
+						bad_want = pw;
+					}
+				} else if (outside) {
+					out_n++;
+					out_ok += got == D_SENTINEL;
+				}
+			}
+		}
+		printf("WHYRED GPU: 3D draw: %u of %u inside pixels have the colour, %u of %u outside untouched%s, "
+		    "RBBM_STATUS %08x\n", in_ok, in_n, out_ok, out_n,
+		    (in_ok == in_n && out_ok == out_n) ? " (ALL CORRECT)" : "", rd(gpu, A5_RBBM_STATUS));
+		flush_dcache64((addr64_t)(pa + 0x7000), 0x80, TRUE);
+		printf("WHYRED GPU: RB counters (delta): TOTAL_PASS %u C_WRITE %u STALL_CCU %u BUSY %u\n",
+		    rd(gpu, 0x0440u * 4) - pc0[0], rd(gpu, 0x0442u * 4) - pc0[1],
+		    rd(gpu, 0x0444u * 4) - pc0[2], rd(gpu, 0x0446u * 4) - pc0[3]);
+		printf("WHYRED GPU: shader markers: VS %08x FS %08x (want a5a50002 / f5f50001)\n",
+		    *(volatile uint32_t *)(va + 0x7000), *(volatile uint32_t *)(va + 0x7040));
+		{
+			uint32_t changed = 0, first = 0xffffffffu;
+			for (uint32_t i = 0; i < D_W * D_H; i++) {
+				if (rt[i] != D_SENTINEL) {
+					changed++;
+					if (first == 0xffffffffu) {
+						first = i;
+					}
+				}
+			}
+			printf("WHYRED GPU: render target words changed: %u, first at %u (%08x)\n", changed,
+			    first, first == 0xffffffffu ? 0 : rt[first]);
+		}
+		printf("WHYRED GPU: samples (24,24)=%08x (30,30)=%08x (40,20)=%08x (50,50)=%08x (2,2)=%08x\n",
+		    rt[24 * D_W + 24], rt[30 * D_W + 30], rt[20 * D_W + 40], rt[50 * D_W + 50], rt[2 * D_W + 2]);
+		if (first_bad != 0xffffffffu) {
+			printf("WHYRED GPU: first wrong inside pixel (%u,%u): got %08x want %08x\n",
+			    first_bad % D_W, first_bad / D_W, rt[first_bad], bad_want);
+		}
+		if (in_ok == in_n && out_ok == out_n) {
+			break;
+		}
+	}
+}
+
+static void
+whyred_gpu_thread(__unused void *arg, __unused wait_result_t wr_)
+{
+	uint32_t step = 0, delay_s = 25;
+
+	(void)PE_parse_boot_argn("whyredgpu", &step, sizeof(step));
+	(void)PE_parse_boot_argn("whyredgpudelay", &delay_s, sizeof(delay_s));
+	if (delay_s > 300) {
+		delay_s = 300;
+	}
+	printf("WHYRED GPU: ladder up to step %u in %u s\n", step, delay_s);
+	whyred_wait(delay_s * 1000);
+
+	gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	gpucc = ml_io_map(GPUCC_PA, GPUCC_SIZE);
+	if (gcc == 0 || gpucc == 0) {
+		printf("WHYRED GPU: map failed gcc %p gpucc %p\n", (void *)gcc,
+		    (void *)gpucc);
+		return;
+	}
+	step1_reads();
+	if (step >= 2) {
+		step2_votes();
+	}
+	if (step >= 3 && step3_cx() != 0) {
+		printf("WHYRED GPU: stopped before step 4 (CX or AHB not ready)\n");
+		return;
+	}
+	if (step >= 4) {
+		gpu = ml_io_map(GPU_PA, GPU_SIZE);
+		if (gpu == 0) {
+			printf("WHYRED GPU: GPU block map failed\n");
+			return;
+		}
+		step4_gx();
+	}
+	if (step >= 5) {
+		step5_scm();
+	}
+	if (step >= 6) {
+		step6_zap();
+	}
+	if (step >= 7) {
+		step7_smmu();
+	}
+	if (step >= 8) {
+		step8_smmu_bypass();
+	}
+	if (step >= 9) {
+		step9_smmu_s1();
+	}
+	if (step >= 10) {
+		step10_ucode_ring();
+	}
+	if (step >= 11) {
+		step11_cp_start();
+	}
+	if (step >= 12) {
+		step12_fence_reset();
+	}
+	if (step >= 13) {
+		step13_compute(0);
+	}
+	if (step == 14 || step == 16) {
+		step13_compute(step == 14 ? 2 : 3);	/* 14: ldg+stg copy, 16: copy of a GPU-written word */
+	}
+	if (step >= 18 && step <= 20) {
+		step18_blit2d();
+	}
+	if (step >= 19 && step <= 20) {
+		step19_blit_rgba();
+	}
+	if (step == 20) {
+		step20_blit_fill();
+	}
+	if (step == 21) {
+		step21_draw(0);
+	}
+	if (step == 22) {
+		step21_draw(1);
+	}
+	if (step == 23) {
+		step21_draw(2);
+	}
+	if (step >= 24) {
+		step21_draw(3);
+	}
+	if (step == 17) {
+		step13_compute(4);	/* 64 threads: probe the local id */
+		step13_compute(5);	/* 64 threads: out[tid] = in[tid] + K */
+		step13_compute(5);
+	}
+	if (step == 15) {
+		/* 15: the copy three times (is it repeatable?), then ldg+add+stg three times */
+		for (int i = 0; i < 3; i++) {
+			step13_compute(2);
+		}
+		for (int i = 0; i < 3; i++) {
+			step13_compute(1);
+		}
+	}
+	printf("WHYRED GPU: ladder finished\n");
+}
+
+int
+whyred_gpu_probe(void)
+{
+	static int started;
+	uint32_t step = 0;
+	thread_t thread;
+
+	if (started || !PE_parse_boot_argn("whyredgpu", &step, sizeof(step)) ||
+	    step == 0) {
+		return 0;
+	}
+	started = 1;
+	if (kernel_thread_start(whyred_gpu_thread, NULL, &thread) ==
+	    KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	return 0;
+}
+
+#else /* !ARM64_BOARD_CONFIG_WHYRED */
+
+int whyred_gpu_probe(void);
+int
+whyred_gpu_probe(void)
+{
+	return 0;
+}
