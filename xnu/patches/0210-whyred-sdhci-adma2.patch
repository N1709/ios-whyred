+/* Clover prepareReadPath()/drainReadFifo(): a retry must not consume a
+ * failed request's tail as its own sector. Read only the FIFO, never write
+ * filler data, and bound both time and discarded dwords. */
+static int
+sdhci_drain_read_fifo(void)
+{
+	uint64_t deadline;
+	uint32_t words = 0;
+
+	nanoseconds_to_deadline(PIO_DRAIN_TIMEOUT_NS, &deadline);
+	while (hc_rd(SDHCI_PRESENT_STATE) & SDHCI_PSTATE_BUF_RD_READY) {
+		if (words >= BOUNCE_SIZE / 4 || mach_absolute_time() >= deadline) {
+			printf("WHYRED SDHCI: stale FIFO did not drain (%u words)\n", words);
+			return ETIMEDOUT;
+		}
+		(void)hc_rd(SDHCI_BUFFER);
+		words++;
+	}
+	return 0;
+}
