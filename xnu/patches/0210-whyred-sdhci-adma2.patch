+	sdhci_v5_standard_fifo();
+	if (hc_rd(SDHCI_PRESENT_STATE) & busy) {
+		error = sdhci_reset_paths();
+		if (error) {
+			return error;
+		}
+	}
+	error = sdhci_drain_read_fifo();
+	if (error) {
+		return error;
+	}
+	return (hc_rd(SDHCI_PRESENT_STATE) & busy) ? EBUSY : 0;
