+	    "8-bit %s, HS %s, base clock %u MHz, max block %u; "
+	    "SDR50 %s SDR104 %s DDR50 %s\n",
+	    (caps & (1u << 22)) ? "yes" : "no",
+	    (caps & (1u << 19)) ? "yes" : "no",
+	    (caps & (1u << 28)) ? "yes" : "no",
+	    (caps & (1u << 18)) ? "yes" : "no",
+	    (caps & (1u << 21)) ? "yes" : "no",
+	    (caps >> 8) & 0xff, 512u << ((caps >> 16) & 3),
+	    (caps1 & 1u) ? "yes" : "no", (caps1 & 2u) ? "yes" : "no",
+	    (caps1 & 4u) ? "yes" : "no");
