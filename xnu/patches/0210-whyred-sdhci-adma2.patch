+	printf("WHYRED SDHCI: dma-diag: HOST_VERSION 0x%04x CAPS 0x%08x "
+	    "CAPS1 0x%08x VENDOR_CAPS0 0x%08x\n", hc_rd16(SDHCI_HOST_VERSION),
+	    caps, caps1, hc_rd(CORE_VENDOR_SPEC_CAPS0));
