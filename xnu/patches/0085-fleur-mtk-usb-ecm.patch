+/*
+ * U2 PHY power-on in device mode: mt6781 usb20_phy.c usb_phy_recover()
+ * ("M17_USB_PWR Sequence") without the efuse calibration, then
+ * set_usb_phy_mode(PHY_MODE_USB_DEVICE), which forces VBUSVALID, AVALID,
+ * BVALID and IDDIG=1 (B-device) in U2PHYDTM1, like QSCRATCH's VBUS
+ * override on Qualcomm: the charger driver that would report the cable
+ * does not exist here.
+ */
+static void
+ud_phy_device_mode(vm_offset_t phy)
+{
+	delay(50);
+	phy_set(phy, PHY_DTM0, 1u << 18);               /* force_suspendm */
+	phy_clr(phy, PHY_DTM0, 1u << 3);                /* RG_SUSPENDM pulse */
+	phy_set(phy, PHY_DTM0, 1u << 3);
+	delay(30);
+	phy_clr(phy, PHY_DTM0, 1u << 18);
+	phy_clr(phy, PHY_DTM0, 1u << 3);
+	phy_clr(phy, PHY_ACR7, 1u << 12);               /* PUPD_BIST_EN */
+	phy_clr(phy, PHY_DTM0, 1u << 26);               /* force_uart_en */
+	phy_clr(phy, PHY_DTM1, 1u << 16);               /* RG_UART_EN */
+	phy_clr(phy, PHY_ACR4, (1u << 9) | (1u << 8));  /* rg_usb20_gpio_ctl, usb20_gpio_mode */
+	phy_clr(phy, PHY_DTM0, (1u << 6) | (1u << 7));  /* RG_DP/DMPULLDOWN */
+	phy_clr(phy, PHY_DTM0, 3u << 4);                /* RG_XCVRSEL */
+	phy_clr(phy, PHY_DTM0, 1u << 2);                /* RG_TERMSEL */
+	phy_clr(phy, PHY_DTM0, 0xfu << 10);             /* RG_DATAIN */
+	phy_clr(phy, PHY_DTM0, (1u << 20) | (1u << 21) | (1u << 19) | (1u << 17) | (1u << 23)); /* force_* */
+	phy_clr(phy, PHY_ACR6, 1u << 23);               /* RG_USB20_BC11_SW_EN */
+	phy_set(phy, PHY_ACR6, 1u << 20);               /* RG_USB20_OTG_VBUSCMP_EN */
+	phy_clr(phy, PHY_ACR6, 0xffu << 24);            /* RG_USB20_PHY_REV = 0x40 */
+	phy_set(phy, PHY_ACR6, 0x40u << 24);
+	delay(800);
+	phy_clr(phy, PHY_DTM1, 0x10);                   /* SESSEND = 0 */
+	phy_set(phy, PHY_DTM1, 0x2f);                   /* VBUSVALID AVALID BVALID IDDIG IDPULLUP */
+	phy_set(phy, PHY_DTM1, 0x3fu << 8);             /* ... forced */
+	phy_clr(phy, PHY_ACR6, 0xf0);                   /* RG_USB20_DISCTH = 0x7 (700 mV) */
+	phy_set(phy, PHY_ACR6, 0x70);
+	phy_clr(phy, PHY_ACR6, 1u << 28);               /* HQA settings */
+	phy_clr(phy, PHY_ACR6, 0xf);
+	phy_set(phy, PHY_ACR6, 0x2);
+	phy_set(phy, PHY_ACR2, 1u << 3);
