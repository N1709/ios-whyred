+static void
+usb_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+phy_set(vm_offset_t phy, uint32_t off, uint32_t bits)
+{
+	usb_wr(phy, off, usb_rd(phy, off) | bits);
+}
+
+static void
+phy_clr(vm_offset_t phy, uint32_t off, uint32_t bits)
+{
+	usb_wr(phy, off, usb_rd(phy, off) & ~bits);
+}
+
+static uint8_t
+musb_rd8(vm_offset_t m, uint32_t off)
+{
+	uint8_t v = *(volatile uint8_t *)(m + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static uint16_t
+musb_rd16(vm_offset_t m, uint32_t off)
+{
+	uint16_t v = *(volatile uint16_t *)(m + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
