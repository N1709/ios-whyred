 	touch_early_mark(19, 0xffffffff);	/* white: done */
@@ -2180,7 +2302,7 @@ santoni_touch_probe(void)
 		} else {
 			dsx_reset_probe();
 		}
-		if (!dsx_early_ran && dsx_addressable && dsx_f12_found) {
+		if (dsx_f12_found) {
 			(void)dsx_f12_program();
 		}
 		dsx_f12_poll();
@@ -2244,6 +2366,12 @@ santoni_touch_probe(void)
 	    reboot) {
 		whyred_reboot_bootloader();
 	}
+	/*
+	 * Diagnostics are done, so the poll thread can own the bus. It starts
