+/*
+ * sweetgpudebug=1: walk this client's GPU page tables for jc (software tree
+ * and the hardware entries the GPU reads) and dump the first 64 bytes of the
+ * job descriptor twice: through the cacheable physmap (what the CPU sees)
+ * and through an uncached device mapping of the same physical page (what
+ * the GPU sees in RAM). A difference means CPU-cache incoherence.
+ */
+void
+FleurMaliGPU::debugJob(FleurGPUJob *job, unsigned js, const char *when)
+{
+	FleurMaliGPUUserClient *c = job->client;
+	uint64_t va = job->jc;
+	FleurPT *pt = c->fRoot;
+	uint64_t e[4] = { 0, 0, 0, 0 };
+	for (unsigned level = 0; level < 4 && pt != NULL; level++) {
+		unsigned idx = (unsigned)(va >> (39 - 9 * level)) & 0x1ffu;
+		e[level] = pt->va[idx];
+		pt = (level < 3 && pt->child != NULL) ? pt->child[idx] : NULL;
+	}
+	IOLog("SWEET GPU: dbg %s seq %llu js%u jc %#llx pte L0 %#llx L1 %#llx L2 %#llx L3 %#llx\n",
+	    when, job->seq, js, va, e[0], e[1], e[2], e[3]);
+	IOLog("SWEET GPU: dbg %s job rawstat %#x js_state %#x js%u status %#x head %#llx tail %#llx "
+	    "mmu rawstat %#x as%d faultstatus %#x faultaddr %#llx\n",
+	    when, rd(JOB_IRQ_RAWSTAT), rd(0x1010u), js, rd(JS_REG(js, JS_STATUS)),
+	    rd64(JS_REG(js, JS_HEAD_LO)), rd64(JS_REG(js, JS_TAIL_LO)), rd(MMU_IRQ_RAWSTAT),
+	    c->fAs, rd(AS_REG((unsigned)c->fAs, AS_FAULTSTATUS)),
+	    rd64(AS_REG((unsigned)c->fAs, AS_FAULTADDRESS_LO)));
+	if ((e[3] & 0x3ull) != PTE_PAGE) {
+		return;
+	}
+	uint64_t pa = (e[3] & PTE_ADDR_MASK) | (va & 0xfffull);
+	uint64_t page = pa & ~((uint64_t)PAGE_MASK);
+	if ((pa & 63u) != 0 || (pa - page) + 64 > PAGE_SIZE) {
+		return;
+	}
+	volatile uint32_t *cached = (volatile uint32_t *)phystokv(pa);
+	vm_offset_t un = ml_io_map((vm_offset_t)page, PAGE_SIZE);
+	if (un == 0) {
+		return;
+	}
+	volatile uint32_t *uncached = (volatile uint32_t *)(un + (pa - page));
+	uint32_t a[16], b[16];
+	for (unsigned i = 0; i < 16; i++) {
+		a[i] = cached[i];
+		b[i] = uncached[i];
+	}
+	ml_io_unmap(un, PAGE_SIZE);
+	IOLog("SWEET GPU: dbg %s pa %#llx cached   %08x %08x %08x %08x %08x %08x %08x %08x "
+	    "%08x %08x %08x %08x %08x %08x %08x %08x\n", when, pa, a[0], a[1], a[2], a[3], a[4],
+	    a[5], a[6], a[7], a[8], a[9], a[10], a[11], a[12], a[13], a[14], a[15]);
+	IOLog("SWEET GPU: dbg %s pa %#llx uncached %08x %08x %08x %08x %08x %08x %08x %08x "
+	    "%08x %08x %08x %08x %08x %08x %08x %08x%s\n", when, pa, b[0], b[1], b[2], b[3], b[4],
+	    b[5], b[6], b[7], b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15],
+	    memcmp(a, b, sizeof(a)) ? "  <- DIFFERS from cached" : "");
+}
