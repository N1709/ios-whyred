 #define EARLY_CELL_W (8u * EARLY_SCALE)
 #define EARLY_CELL_H (16u * EARLY_SCALE)
@@ -27,6 +29,51 @@
 /* Initialized data must remain writable until disable, including panics. */
 static unsigned int early_row, early_col;
 static unsigned int early_started, early_disabled, early_panicking;
+
+/* Refuse malformed or unmapped surfaces instead of touching a fallback PA. */
+void
+sweet_early_init(uint64_t base, uint64_t width, uint64_t height, uint64_t stride, uint64_t depth)
+{
+	early_disabled = 1;
+	if (!base || (base & 3) || (depth & 0xff) != 32 ||
+	    width < EARLY_CELL_W || width > 4096 ||
+	    height < EARLY_CELL_H + 32 || height > 8192 ||
+	    stride < width * 4 || stride > 32768 || (stride & 3) ||
+	    stride * height > (32ULL << 20) || base + stride * height < base) {
+		return;
+	}
+	/* start.s may have rejected a RAM collision. Verify both ends before
+	 * any store. PAR_EL1 bit0 is the architectural translation fault bit. */
+	uint64_t first, last;
+	__asm__ volatile("at s1e1w, %1; isb; mrs %0, par_el1" : "=r"(first) : "r"(base) : "memory");
+	__asm__ volatile("at s1e1w, %1; isb; mrs %0, par_el1" : "=r"(last) : "r"(base + stride * height - 4) : "memory");
+	if ((first | last) & 1) {
+		return;
+	}
+	/* Both ends must have the same Normal-NC attributes as start.s. */
+	if ((first >> 56) != 0x44 || (last >> 56) != 0x44) {
+		return;
+	}
+	early_fb = (volatile uint32_t *)(uintptr_t)base;
+	early_phys = base;
+	early_bytes = stride * height;
+	early_width = (unsigned int)width;
+	early_height = (unsigned int)height;
+	early_stride = (unsigned int)(stride / 4);
+	early_row = early_col = early_started = early_panicking = 0;
+	early_disabled = 0;
+}
+
+int
+sweet_early_surface(uint64_t *base, uint64_t *size)
+{
+	if (early_disabled || !early_fb) {
+		return 0;
+	}
+	*base = early_phys;
+	*size = early_bytes;
+	return 1;
+}
 
