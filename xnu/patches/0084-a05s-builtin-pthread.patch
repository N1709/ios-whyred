diff --git a/bsd/conf/Makefile.template b/bsd/conf/Makefile.template
--- a/bsd/conf/Makefile.template
+++ b/bsd/conf/Makefile.template
@@ -45,7 +45,7 @@
 SFLAGS+= -include meta_features.h
 
 # This provider is built into SWEET; other boards use their normal kext.
-ifeq ($(CURRENT_MACHINE_CONFIG),SWEET)
+ifneq ($(filter SWEET A05S,$(CURRENT_MACHINE_CONFIG)),)
 SWEET_PTHREAD_ROOT = $(SRCROOT)/bsd/pthread/sweet_libpthread
 SWEET_PTHREAD_INC = -I$(SWEET_PTHREAD_ROOT) -I$(SWEET_PTHREAD_ROOT)/private -I$(SWEET_PTHREAD_ROOT)/include
 sweet_pthread_init.o_INCFLAGS = $(SWEET_PTHREAD_INC)
diff --git a/bsd/pthread/sweet_pthread_init.c b/bsd/pthread/sweet_pthread_init.c
--- a/bsd/pthread/sweet_pthread_init.c
+++ b/bsd/pthread/sweet_pthread_init.c
@@ -1,5 +1,5 @@
 /* Built-in provider: Apple libpthread-514.100.2, paired with xnu-8796.141.3. */
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_NON_APPLE_BRINGUP)
 #include "sweet_pthread_compat.h"
 #include "sweet_libpthread/kern/kern_init.c"
 
@@ -23,4 +23,4 @@
     kprintf("SWEET pthread: libpthread-514.100.2 registered\n");
 }
 STARTUP(EARLY_BOOT, STARTUP_RANK_SECOND, sweet_pthread_register);
-#endif /* ARM64_BOARD_CONFIG_SWEET */
+#endif /* ARM64_NON_APPLE_BRINGUP */
