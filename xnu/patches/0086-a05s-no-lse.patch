diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -62,7 +62,7 @@
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a
 MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
 MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET -DARM64_NON_APPLE_BRINGUP                -march=armv8.2-a+crypto
-MACHINE_FLAGS_ARM64_A05S = -DARM64_BOARD_CONFIG_A05S -DARM64_NON_APPLE_BRINGUP                  -march=armv8-a+crypto
+MACHINE_FLAGS_ARM64_A05S = -DARM64_BOARD_CONFIG_A05S -DARM64_NON_APPLE_BRINGUP -DNO_LSE_ATOMICS                  -march=armv8-a+crypto -Xclang -target-feature -Xclang -lse
 
 
