+
+static uint64_t
+fg_rd64(vm_offset_t base, uint32_t lo)
+{
+	uint64_t l = fg_rd(base, lo);
+	return l | ((uint64_t)fg_rd(base, lo + 4) << 32);
+}
+
+static void
+fg_wr64(vm_offset_t base, uint32_t lo, uint64_t v)
+{
+	fg_wr(base, lo, (uint32_t)v);
+	fg_wr(base, lo + 4, (uint32_t)(v >> 32));
+}
+
+static volatile uint64_t *
+fj_u64(uint32_t off)
+{
+	return (volatile uint64_t *)(fj.va + off);
+}
+
+/* Clean + invalidate the CPU caches for [off, off + len) of the job memory. */
+static void
+fj_sync(uint32_t off, uint32_t len)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+	flush_dcache64((addr64_t)(fj.pa + off), len, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
