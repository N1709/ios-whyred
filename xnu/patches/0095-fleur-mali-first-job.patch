+	    fg_rd(fg.gpu, JS_REG(js, JS_STATUS)), fg_rd64(fg.gpu, JS_REG(js, JS_HEAD_LO)),
+	    fg_rd64(fg.gpu, JS_REG(js, JS_TAIL_LO)), fg_rd(fg.gpu, JS_REG(js, JS_CONFIG)));
+	printf("SWEET GPU: [%s] mmu rawstat %#x as0 status %#x faultstatus %#x faultaddr %#llx; gpu rawstat %#x faultstatus %#x status %#x\n",
+	    when, fg_rd(fg.gpu, MMU_IRQ_RAWSTAT), fg_rd(fg.gpu, AS_REG(0, AS_STATUS)),
+	    fg_rd(fg.gpu, AS_REG(0, AS_FAULTSTATUS)), fg_rd64(fg.gpu, AS_REG(0, AS_FAULTADDRESS_LO)),
+	    fg_rd(fg.gpu, GPU_IRQ_RAWSTAT), fg_rd(fg.gpu, GPU_FAULTSTATUS), fg_rd(fg.gpu, GPU_STATUS));
+}
+
+/* wait_ready() + write_cmd() of panfrost_mmu.c, 100 ms bound. */
+static bool
+fg_as_cmd(uint32_t cmd)
+{
+	if (!fg_poll(fg.gpu, AS_REG(0, AS_STATUS), AS_STATUS_ACTIVE, 0, 100000)) {
+		printf("SWEET GPU: AS0 stuck active before cmd %u\n", cmd);
+		return false;
+	}
+	fg_wr(fg.gpu, AS_REG(0, AS_COMMAND), cmd);
+	if (!fg_poll(fg.gpu, AS_REG(0, AS_STATUS), AS_STATUS_ACTIVE, 0, 100000)) {
+		printf("SWEET GPU: AS0 cmd %u did not complete\n", cmd);
+		return false;
+	}
+	return true;
+}
+
+/* Page tables, job and sentinel in the CPU view; all written back to RAM. */
+static bool
+fg_job_build(void)
+{
+	if (fj.va == 0) {
+		if (kmem_alloc_contig(kernel_map, &fj.va, JOBMEM_SIZE, PAGE_MASK, 0, 0,
+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			printf("SWEET GPU: no contiguous memory for the job\n");
+			fj.va = 0;
+			return false;
+		}
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)fj.va);
+		if (pn == 0) {
+			printf("SWEET GPU: job memory has no physical page\n");
+			return false;
+		}
+		fj.pa = ptoa_64(pn);
+	}
+	bzero((void *)fj.va, JOBMEM_SIZE);
+
+	/* VA 0x1000000: L0[0] -> L1[0] -> L2[8] -> L3[0] (job), L3[1] (result). */
+	uint64_t ate = PTE_PAGE | PTE_ATTR(0) | PTE_RW | PTE_AF | PTE_NX;
+	*fj_u64(JOBMEM_L0 + 8 * ((JOB_VA >> 39) & 0x1ffu)) = (fj.pa + JOBMEM_L1) | PTE_TABLE;
+	*fj_u64(JOBMEM_L1 + 8 * ((JOB_VA >> 30) & 0x1ffu)) = (fj.pa + JOBMEM_L2) | PTE_TABLE;
+	*fj_u64(JOBMEM_L2 + 8 * ((JOB_VA >> 21) & 0x1ffu)) = (fj.pa + JOBMEM_L3) | PTE_TABLE;
+	*fj_u64(JOBMEM_L3 + 8 * ((JOB_VA >> 12) & 0x1ffu)) = (fj.pa + JOBMEM_JOB) | ate;
+	*fj_u64(JOBMEM_L3 + 8 * ((RESULT_VA >> 12) & 0x1ffu)) = (fj.pa + JOBMEM_RESULT) | ate;
+
+	/*
+	 * Job Header: w0 exception status, w1 first incomplete task, w2-3 fault
+	 * pointer, w4 [7:1] type, [31:16] index, w5 dependencies, w6-7 next.
+	 * Write Value payload at +32: address, +40 type, +48 immediate.
+	 */
+	volatile uint32_t *job = (volatile uint32_t *)(fj.va + JOBMEM_JOB);
+	job[4] = (JOB_TYPE_WRITE_VALUE << 1) | (1u << 16);
+	*fj_u64(JOBMEM_JOB + 32) = RESULT_VA;
+	job[10] = WRITE_VALUE_IMM64;
+	*fj_u64(JOBMEM_JOB + 48) = RESULT_MAGIC;
+	*fj_u64(JOBMEM_RESULT) = RESULT_SENTINEL;
+	fj_sync(0, JOBMEM_SIZE);
+	printf("SWEET GPU: job memory va %#lx pa %#llx; job VA %#llx result VA %#llx\n",
+	    (unsigned long)fj.va, fj.pa, JOB_VA, RESULT_VA);
+	return true;
+}
+
+/* panfrost_mmu_enable() for AS0 with the AArch64 4K format. */
+static bool
+fg_as0_enable(void)
+{
+	printf("SWEET GPU: coherency features %#x enable %#x -> none\n",
+	    fg_rd(fg.gpu, GPU_COHERENCY_FEATURES), fg_rd(fg.gpu, GPU_COHERENCY_ENABLE));
+	fg_wr(fg.gpu, GPU_COHERENCY_ENABLE, GPU_COHERENCY_NONE);
+	fg_wr(fg.gpu, MMU_IRQ_CLEAR, 0xffffffffu);
+	/* lock_region(0, ~0): width 63, start 0; then FLUSH_MEM. */
+	fg_wr64(fg.gpu, AS_REG(0, AS_LOCKADDR_LO), 63);
+	if (!fg_as_cmd(AS_CMD_LOCK) || !fg_as_cmd(AS_CMD_FLUSH_MEM)) {
+		return false;
+	}
+	uint64_t memattr = 0;
+	for (unsigned i = 0; i < 8; i++) {
+		memattr |= (uint64_t)AS_MEMATTR_NC << (8 * i);
+	}
+	fg_wr64(fg.gpu, AS_REG(0, AS_TRANSTAB_LO), fj.pa + JOBMEM_L0);
+	fg_wr64(fg.gpu, AS_REG(0, AS_MEMATTR_LO), memattr);
+	fg_wr64(fg.gpu, AS_REG(0, AS_TRANSCFG_LO), AS_TRANSCFG_VAL);
+	if (!fg_as_cmd(AS_CMD_UPDATE)) {
+		return false;
+	}
+	printf("SWEET GPU: AS0 transtab %#llx memattr %#llx transcfg %#llx status %#x\n",
+	    fg_rd64(fg.gpu, AS_REG(0, AS_TRANSTAB_LO)), fg_rd64(fg.gpu, AS_REG(0, AS_MEMATTR_LO)),
+	    fg_rd64(fg.gpu, AS_REG(0, AS_TRANSCFG_LO)), fg_rd(fg.gpu, AS_REG(0, AS_STATUS)));
+	return true;
+}
+
+/* panfrost_job_hw_submit() for one chain, then bounded polling (IRQs masked). */
+static void
+fg_first_job(void)
+{
+	uint32_t js = fg.js;
+	uint32_t done = 1u << js, fail = 1u << (16 + js);
+	if (js > 2 || !(fg_rd(fg.gpu, GPU_JS_PRESENT) & (1u << js)) ||
+	    !(fg_rd(fg.gpu, GPU_JS_FEATURES(js)) & JS_FEATURE_SET_VALUE)) {
+		printf("SWEET GPU: job slot %u absent or without WRITE_VALUE\n", js);
+		return;
+	}
+	if (!fg_job_build()) {
+		return;
+	}
+	fg_checkpoint("AS0 setup (MMU)");
+	if (!fg_as0_enable()) {
+		fg_dump_job_state("as0");
+		return;
+	}
+	if (fg_rd(fg.gpu, JS_REG(js, JS_COMMAND_NEXT)) != 0) {
+		printf("SWEET GPU: js%u COMMAND_NEXT busy\n", js);
+		return;
+	}
+	fg_wr(fg.gpu, JOB_IRQ_CLEAR, 0xffffffffu);
+	fg_dump_job_state("before");
+	fg_checkpoint("WRITE_VALUE job start");
+	uint64_t affinity = fg_rd64(fg.gpu, GPU_SHADER_PRESENT);
+	fg_wr64(fg.gpu, JS_REG(js, JS_HEAD_NEXT_LO), JOB_VA);
+	fg_wr64(fg.gpu, JS_REG(js, JS_AFFINITY_NEXT_LO), affinity);
+	fg_wr(fg.gpu, JS_REG(js, JS_CONFIG_NEXT), 0u /* AS0 */ | JS_CFG_THREAD_PRI(8) |
+	    JS_CFG_START_FLUSH_CLEAN_INV | JS_CFG_END_FLUSH_CLEAN_INV);
+	fg_wr(fg.gpu, JS_REG(js, JS_COMMAND_NEXT), JS_CMD_START);
+
+	uint32_t raw = 0;
+	bool finished = false;
+	for (unsigned i = 0; i <= 100000 && !finished; ++i) {
+		raw = fg_rd(fg.gpu, JOB_IRQ_RAWSTAT);
+		finished = (raw & (done | fail)) != 0;
+		if (!finished) {
+			delay(1);
+		}
+	}
+	fg_dump_job_state(finished ? "after" : "timeout");
+	if (!finished) {
+		fg_wr(fg.gpu, JS_REG(js, JS_COMMAND), JS_CMD_HARD_STOP);
+		(void)fg_poll(fg.gpu, JOB_IRQ_RAWSTAT, done | fail, done | fail, 10000);
+		fg_dump_job_state("hard-stop");
+	}
+	fg_wr(fg.gpu, JOB_IRQ_CLEAR, 0xffffffffu);
+	fg_wr(fg.gpu, MMU_IRQ_CLEAR, 0xffffffffu);
+
+	/* The job's END flush cleaned the GPU L2; drop any stale CPU lines. */
+	fj_sync(JOBMEM_JOB, 0x2000);
+	volatile uint32_t *job = (volatile uint32_t *)(fj.va + JOBMEM_JOB);
+	uint64_t result = *fj_u64(JOBMEM_RESULT);
+	printf("SWEET GPU: job header exception %#x first_incomplete %#x fault_ptr %#llx\n",
+	    job[0], job[1], *fj_u64(JOBMEM_JOB + 8));
+	printf("SWEET GPU: result %#llx (%s; sentinel %#llx, expected %#llx)\n", result,
+	    result == RESULT_MAGIC ? "WRITE_VALUE OK" :
+	    result == RESULT_SENTINEL ? "not written" : "unexpected",
+	    RESULT_SENTINEL, RESULT_MAGIC);
 }
 
